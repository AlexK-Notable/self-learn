#!/usr/bin/env bash
# self-learn-notify — G-3 desktop notifier (10 §1 "Companion scripts"
# row; 09 §3 "Notifications"). Pinned argv, carried verbatim (P3-6):
#
#   self-learn-notify --line "<rendered human string>" --ids <csv-of-record-ids>
#
# notify-send -A open --wait, BOUNDED via --expire-time. This host's
# swaync shelves an expired action-capable popup WITHOUT emitting
# NotificationClosed when the wait is unbounded — an unbounded --wait
# hangs forever (user CLAUDE.md pinned lesson, this host). Branch on the
# ACTION OUTPUT (notify-send's stdout — the clicked action id), never on
# the exit code alone, to tell "open" clicked apart from "dismissed/
# timed out" (both exit 0; the CLAUDE.md lesson: expiry gives rc 0,
# stderr "Wait timeout expired", EMPTY stdout).
#
# BUILD FINDING (verified against the installed notify-send 0.8.8
# --help text): `-A, --action=[NAME=]Text` — the printed-on-click value
# is NAME, which defaults to the option's numerical INDEX ("0") when no
# "NAME=" prefix is given. A bare `-A open` would therefore print "0" on
# click, never the string "open" this script branches on. The action is
# registered below as `-A "open=Open"` (NAME=open, visible label "Open")
# so a click genuinely prints "open" to stdout — the literal `-A open`
# invocation this row's prose names does not, on this host's installed
# version, produce the behavior the same row requires two sentences
# later ("on action 'open' -> exec ..."). Flagged, not silently
# reconciled without a trace.
#
# Degradation (09 §5 "swaync absent / action unsupported"):
#   - `notify-send` missing entirely -> no daemon at all -> exit 0,
#     silent (nothing to try).
#   - `notify-send -A ... --wait` itself exits non-zero -> action
#     registration failed (no action-capable daemon) -> fall back to a
#     plain, non-action notify-send (M2's existing informative-only
#     behavior) -> exit 0 either way (best-effort; its own outcome is
#     never fatal to this script).
#   - exits 0 with stdout "open" -> the pinned deep-link rule: the FIRST
#     id in the csv -> exec self-learn-ui-open --record <id>.
#   - exits 0 with any other stdout (typically empty: dismissed or
#     expired) -> nothing more to do, exit 0.
#
# readlink -f is LOAD-BEARING (P3-1): install.sh deploys ~/bin scripts as
# symlinks, so the sibling self-learn-ui-open is resolved relative to
# THIS file's real location, never $(dirname "$0") of a symlink.
set -euo pipefail

EXPIRE_TIME_MS=30000

LINE=""
IDS=""
while [[ $# -gt 0 ]]; do
  case "$1" in
    --line)
      if [[ $# -lt 2 ]]; then
        echo "self-learn-notify: --line requires a value" >&2
        exit 2
      fi
      LINE="$2"
      shift 2
      ;;
    --ids)
      if [[ $# -lt 2 ]]; then
        echo "self-learn-notify: --ids requires a value" >&2
        exit 2
      fi
      IDS="$2"
      shift 2
      ;;
    *)
      echo "self-learn-notify: unknown argument: $1" >&2
      exit 2
      ;;
  esac
done

if [[ -z "$LINE" || -z "$IDS" ]]; then
  echo "self-learn-notify: --line and --ids are both required" >&2
  exit 2
fi

FIRST_ID="${IDS%%,*}"

SELF_RESOLVED="$(readlink -f "$0")"
SCRIPT_DIR="$(dirname "$SELF_RESOLVED")"
UI_OPEN="${SCRIPT_DIR}/self-learn-ui-open"

# No daemon at all: nothing to try.
command -v notify-send >/dev/null 2>&1 || exit 0

set +e
ACTION="$(notify-send -A "open=Open" --wait --expire-time "$EXPIRE_TIME_MS" \
  "self-learn" "$LINE" 2>/dev/null)"
RC=$?
set -e

if [[ $RC -ne 0 ]]; then
  # No action-capable daemon (the -A/--wait invocation itself failed):
  # degrade to a plain, non-action notification — M2's existing
  # informative-only behavior. Best-effort; never fatal to this script.
  notify-send "self-learn" "$LINE" >/dev/null 2>&1 || true
  exit 0
fi

if [[ "$ACTION" == "open" ]]; then
  exec "$UI_OPEN" --record "$FIRST_ID"
fi

exit 0
