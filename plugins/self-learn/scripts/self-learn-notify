#!/usr/bin/env bash
# self-learn-notify — G-3 desktop notifier (10 §1 "Companion scripts"
# row; 09 §3 "Notifications"). Pinned argv, carried verbatim (P3-6):
#
#   self-learn-notify --line "<rendered human string>" --ids <csv-of-record-ids>
#
# notify-send -A open --wait. CORRECTED 2026-08-09 (incident): the
# original design assumed a finite `--expire-time` alone bounds the
# wait — this was EMPIRICALLY FALSIFIED. Processes carrying the pinned
# argv `--expire-time 30000` were measured still running 39.3 HOURS
# later (peak: 4,617 notify-send + 6,508 wrapper shells), fd-exhausting
# the user-scope dbus-broker and killing the desktop session.
# `--expire-time` only bounds a notification that was actually POSTED
# and is now waiting to be dismissed/timed out by the daemon; a
# daemon-down or bus-degraded state blocks the CLIENT before any
# notification is ever posted, so no expiry timer ever starts. The exact
# matrix of which daemon states do this is UNCONFIRMED, and this fix
# does not depend on knowing it.
#
# THE BOUND IS NOW EXTERNAL: every notify-send invocation below runs
# under `timeout --kill-after=5 40 notify-send ...` — a hard wall-clock
# cap enforced by the KERNEL against the notify-send PROCESS itself,
# independent of what the daemon does or does not do (SIGTERM at 40s;
# SIGKILL 5s later if it does not respond). `--expire-time` is KEPT
# (best-effort: lets a genuinely-posted popup expire on its own, well
# inside the 40s bound, when the daemon IS healthy) but is NO LONGER
# load-bearing for the "this script returns" guarantee — that guarantee
# now belongs entirely to `timeout`.
#
# This host's swaync shelves an expired action-capable popup WITHOUT
# emitting NotificationClosed when the wait is unbounded (user CLAUDE.md
# pinned lesson, this host — ALSO corrected by this fix: the lesson as
# originally recorded credited a finite `-t` with being a sufficient
# bound; it is not — an external `timeout(1)` is required). Branch on
# the ACTION OUTPUT (notify-send's stdout — the clicked action id),
# never on the exit code alone, to tell "open" clicked apart from every
# other outcome — dismissed, timed out by the daemon, OR killed by the
# external `timeout` below all produce a non-"open" result (dismissed/
# expired: rc 0, empty stdout; killed: rc 124 (SIGTERM) or 137 (SIGKILL
# after --kill-after), stdout whatever was captured before the kill,
# never the literal string "open").
#
# BUILD FINDING (verified against the installed notify-send 0.8.8
# --help text): `-A, --action=[NAME=]Text` — the printed-on-click value
# is NAME, which defaults to the option's numerical INDEX ("0") when no
# "NAME=" prefix is given. A bare `-A open` would therefore print "0" on
# click, never the string "open" this script branches on. The action is
# registered below as `-A "open=Open"` (NAME=open, visible label "Open")
# so a click genuinely prints "open" to stdout — the literal `-A open`
# invocation this row's prose names does not, on this host's installed
# version, produce the behavior the same row requires two sentences
# later ("on action 'open' -> exec ..."). Flagged, not silently
# reconciled without a trace.
#
# Degradation (09 §5 "swaync absent / action unsupported"):
#   - `notify-send` missing entirely -> no daemon at all -> exit 0,
#     silent (nothing to try).
#   - `notify-send -A ... --wait` itself exits non-zero (INCLUDING a
#     124/137 from the external timeout bound above) -> action
#     registration failed, or the client never returned in time ->
#     fall back to a plain, non-action notify-send (M2's existing
#     informative-only behavior), ITSELF hard-bounded the same way ->
#     exit 0 either way (best-effort; its own outcome is never fatal to
#     this script).
#   - exits 0 with stdout "open" -> the pinned deep-link rule: the FIRST
#     id in the csv -> exec self-learn-ui-open --record <id>.
#   - exits 0 with any other stdout, OR a timeout-induced non-zero exit
#     (typically empty stdout either way: dismissed, expired, or
#     killed) -> nothing more to do, exit 0.
#
# readlink -f is LOAD-BEARING (P3-1): install.sh deploys ~/bin scripts as
# symlinks, so the sibling self-learn-ui-open is resolved relative to
# THIS file's real location, never $(dirname "$0") of a symlink.
set -euo pipefail

EXPIRE_TIME_MS=30000
# Bug A fix (incident 2026-08-09): the external wall-clock bound on
# EVERY notify-send invocation. 40s comfortably covers the pinned
# 30000ms expire-time plus daemon/process scheduling slack;
# --kill-after=5 escalates to SIGKILL if a SIGTERM'd notify-send (or a
# wedged child of it) does not exit within 5 more seconds.
TIMEOUT_ARGS=(--kill-after=5 40)

LINE=""
IDS=""
while [[ $# -gt 0 ]]; do
  case "$1" in
    --line)
      if [[ $# -lt 2 ]]; then
        echo "self-learn-notify: --line requires a value" >&2
        exit 2
      fi
      LINE="$2"
      shift 2
      ;;
    --ids)
      if [[ $# -lt 2 ]]; then
        echo "self-learn-notify: --ids requires a value" >&2
        exit 2
      fi
      IDS="$2"
      shift 2
      ;;
    *)
      echo "self-learn-notify: unknown argument: $1" >&2
      exit 2
      ;;
  esac
done

if [[ -z "$LINE" || -z "$IDS" ]]; then
  echo "self-learn-notify: --line and --ids are both required" >&2
  exit 2
fi

FIRST_ID="${IDS%%,*}"

SELF_RESOLVED="$(readlink -f "$0")"
SCRIPT_DIR="$(dirname "$SELF_RESOLVED")"
UI_OPEN="${SCRIPT_DIR}/self-learn-ui-open"

# No daemon at all: nothing to try.
command -v notify-send >/dev/null 2>&1 || exit 0

set +e
ACTION="$(timeout "${TIMEOUT_ARGS[@]}" notify-send -A "open=Open" --wait \
  --expire-time "$EXPIRE_TIME_MS" "self-learn" "$LINE" 2>/dev/null)"
RC=$?
set -e

if [[ $RC -ne 0 ]]; then
  # No action-capable daemon (the -A/--wait invocation itself failed),
  # OR the external timeout bound above fired (rc 124/137 — treated
  # identically: "no action" is the only conclusion either way):
  # degrade to a plain, non-action notification — M2's existing
  # informative-only behavior. ALSO hard-bounded (Bug A) — best-effort;
  # never fatal to this script.
  timeout "${TIMEOUT_ARGS[@]}" notify-send "self-learn" "$LINE" >/dev/null 2>&1 || true
  exit 0
fi

if [[ "$ACTION" == "open" ]]; then
  exec "$UI_OPEN" --record "$FIRST_ID"
fi

exit 0
