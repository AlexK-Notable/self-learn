#!/usr/bin/env bash
# self-learn-ui-open — deep-link launcher / window-focuser (10 §1
# "Companion scripts" row; 09 §3 "Deep-link + launcher"). The ONLY
# WM/browser-aware file in the surface (10 §1) — everything else in the
# surface is browser/WM-agnostic by design.
#
# Usage: self-learn-ui-open [--record <id>] [--print-paths]
#
# Sequence (pinned; re-ordered 2026-07-18 — Y-14, 09 §3 "Deep-link +
# launcher": token path now resolves FIRST because the service-up step
# needs a pre-start token snapshot):
#   1. Resolve the token path, snapshot service state + token bytes,
#      ensure the service is up (systemctl --user start
#      self-learn-ui.service — skipped silently if systemctl is absent,
#      10 §5 "systemd absent" playbook), then the Y-14 READINESS WAIT:
#      cold start ⟺ snapshot state anything other than `active` (a
#      click landing in an idle-exit shutdown drain is a cold start
#      too) AND start succeeded → one ≤5 s budget polling for a token
#      that differs from the snapshot (the server writes it before
#      binding), THEN a TCP connect on the port; an unchanged token
#      WITH a successful connect also counts as ready (delta R2, the
#      double-click case). Timeout falls through to today's
#      403-page-names-this-script degradation — never a new failure
#      mode.
#   2. Read the bearer token: primary $XDG_RUNTIME_DIR/self-learn/
#      ui-token; X-8/X-12 fallback (XDG_RUNTIME_DIR unset — headless/SSH)
#      is the home-namespaced cache dir's ui-token (09 §11 Y-3). ONE
#      shared resolution below (X-12: the launcher must apply the SAME
#      fallback the server/ui package uses when it writes the token, or
#      an unset-runtime-dir launcher opens an un-tokened URL and
#      403-loops).
#
#      D8 (10 §1, decision D8): the token path (and the cache dir it can
#      fall back through) is Python-owned truth — self_learn.serve.
#      cache_dir_readonly() / self_learn_ui.middleware.resolve_token_path()
#      — so this script now ASKS for both first, via `timeout 4
#      self-learn-ui paths --json` (the `self-learn-ui` shim resolved off
#      $PATH, exactly like `chromium`/`hyprctl` below — see the NOTE a few
#      lines down). Only when that shim is absent, fails, times out, or
#      answers with unparsable JSON does `_resolve_token_path` below (the
#      bash MIRROR of the same two derivations) run at all — it is the
#      FALLBACK now, not the primary. It stays in the file, byte-for-byte
#      the same formula, because ui/tests/test_wrapper.py's rule ("this
#      suite never depends on network access for uv run's own
#      resolution") still has to hold for THIS script's own tests
#      (ui/tests/test_launcher.py): they PATH-shim `self-learn-ui` as a
#      fake, so a real `uv run` never fires from inside a launcher test
#      either way, and the fallback branch needs real bash logic to fall
#      back TO whenever the fake shim is made to fail. Verified
#      byte-identical against hashlib.sha256(str(Path(home).expanduser())
#      .encode()).hexdigest()[:8] during build; a real drift between this
#      mirror and the CLI's derivation is a §4-class finding, not a
#      silent guess. D8 gate r1 finding 1: `self_learn_ui.middleware.
#      resolve_token_path()`'s own XDG_RUNTIME_DIR-unset fallback now
#      goes through `self_learn.serve.cache_dir_readonly()` too (never
#      the mutating `self_learn.worker.cache_dir()`), so the verb path
#      never mkdirs the cache directory as a side effect — matching this
#      bash mirror exactly, in every scenario, not just the two where
#      XDG_RUNTIME_DIR happens to be set.
#   3. Window-presence detection (X-3, empirically pinned 2026-07-13):
#      query `hyprctl clients -j` for the class FIRST — NEVER branch on
#      `hyprctl dispatch focuswindow`'s exit code (it prints "No such
#      window found" and still exits 0). Present -> focus the window;
#      absent -> launch. hyprctl absent entirely -> skip detection,
#      launch (degrade gracefully).
#   4. Launch: browser resolved in order $SELF_LEARN_UI_BROWSER ->
#      chromium -> google-chrome-stable, as a dedicated app window
#      (`--app=<tokened-url> --class=self-learn-ui`); final fallback is
#      a plain `xdg-open <url>` tab when no chromium-family browser is
#      found.
#   5. Placement (added 2026-07-18 — feedback round 2 item 6; 09 §4.4):
#      $SELF_LEARN_UI_MONITOR (launcher-only, the same X-1 posture as
#      $SELF_LEARN_UI_BROWSER; host-specific, so NEVER hardcoded here)
#      names the monitor the UI window must end up on. Set AND hyprctl
#      present -> after step 3/4 the window's address is resolved via
#      the SAME class-or-title-prefix match (for a fresh launch, polled
#      ≤5 s in 0.1 s steps — the step-1 loop shape); if `hyprctl
#      clients -j`+`monitors -j` show it already on the target (the
#      clients `monitor` field is a numeric id, mapped through
#      `monitors -j` .name), zero dispatches; else focuswindow by
#      address then `movewindow mon:<name>`, the move gated on
#      `activewindow -j` confirming OUR address holds focus (delta F2:
#      a window vanishing mid-sequence must never relocate whatever
#      unrelated window the user has focused). X-3 holds throughout:
#      placement is read from clients/monitors/activewindow JSON, never
#      from a dispatch's exit code. Unset -> today's behavior, zero new
#      dispatches; hyprctl absent or the window never appearing ->
#      degrade silently, never an error.
#
# NOTE: as of D8 this script DOES have a sibling-project dependency —
# `self-learn-ui` (the `paths` verb, above) — but unlike scripts/
# self-learn, scripts/self-learn-ui, and this file's own sibling
# scripts/self-learn-notify, it resolves that dependency the SAME way it
# already resolves chromium/hyprctl/systemctl: `command -v self-learn-ui`
# against $PATH, never a $0-relative sibling path. So the P3-1 readlink
# -f pattern still does not apply here; nothing in this file depends on
# where the ~/bin symlink (vs. the repo) lives — only on `self-learn-ui`
# (itself a ~/bin symlink in production) being reachable on $PATH.
#
# C22 (sprint-1 M-F2, fold r1 m2): every `systemctl`/`hyprctl` call this
# script makes is wrapped in `"${_TO[@]}"` (== `timeout 4`, defined right
# below) — a wedged compositor or user systemd manager must not hang the
# launcher forever. Read-style sites already tolerated the wrapped tool
# being ABSENT (`command -v` guards, `|| return 0`) and a fire-and-forget
# dispatch's `|| true` absorbs a `timeout`-induced failure identically
# for THOSE — but that "same tolerance" claim was FALSE for the one site
# with a real side effect, `systemctl --user start`: a bare `timeout 4`
# prefix means a host that simply lacks the `timeout` BINARY (never a
# dependency before this move introduced it) never execs `systemctl` at
# all, so the service silently never starts even though systemctl itself
# works fine on that host — a regression `timeout`-absence never risked
# pre-C22. `_TO` fixes this for every site at once: empty when `timeout`
# is missing, so `"${_TO[@]}" systemctl …` degrades to the real tool
# running directly and unbounded — exactly the pre-C22 behavior — rather
# than the tool never running at all.
set -euo pipefail

_TO=()
command -v timeout >/dev/null 2>&1 && _TO=(timeout 4)

WINDOW_CLASS="self-learn-ui"
RECORD_ID=""
PRINT_PATHS=0

while [[ $# -gt 0 ]]; do
  case "$1" in
    --record)
      if [[ $# -lt 2 ]]; then
        echo "self-learn-ui-open: --record requires a value" >&2
        exit 2
      fi
      RECORD_ID="$2"
      shift 2
      ;;
    --print-paths)
      # D8 test hook: print the BASH MIRROR's own cache_dir/token_path
      # (never the self-learn-ui verb's) and exit — a contract test
      # needs the mirror's values in isolation to compare against the
      # verb's, and this script had no other debug/print mode to reuse.
      PRINT_PATHS=1
      shift
      ;;
    *)
      echo "self-learn-ui-open: unknown argument: $1" >&2
      exit 2
      ;;
  esac
done

# --- 2. resolve the bearer token path -----------------------------------

# Mirrors self_learn.ledger.resolve_home()'s Path(...).expanduser():
# only a LEADING ~ is expanded (bash never auto-expands a ~ that arrives
# inside a variable's value); a trailing slash is stripped to match
# Python's str(Path(...)) normalization.
# Normalize like Python's str(Path(...)): a LEADING ~ expands (bash never
# auto-expands a ~ inside a variable value), then collapse repeated
# slashes, drop "." segments, strip a trailing slash — but KEEP ".."
# (PurePosixPath does not resolve it). This must match byte-for-byte so
# the launcher and the server hash the SAME string into the same
# home-<digest> cache path (X-12 shared-resolution rule); the interim
# review found "//" and "/." homes diverging and this closes that.
_slug_expand_home() {
  local raw="$1" expanded seg out=""
  case "$raw" in
    "~") expanded="$HOME" ;;
    "~/"*) expanded="$HOME/${raw#\~/}" ;;
    *) expanded="$raw" ;;
  esac
  local absolute=0
  [[ "$expanded" == /* ]] && absolute=1
  local IFS=/
  for seg in $expanded; do
    [[ -z "$seg" || "$seg" == "." ]] && continue
    out="$out/$seg"
  done
  if [[ "$absolute" == 1 ]]; then
    printf '%s' "${out:-/}"
  else
    printf '%s' "${out#/}"
  fi
}

_slug_ledger_home() {
  _slug_expand_home "${SELF_LEARN_HOME:-~/.self-learn}"
}

# Mirrors self_learn.worker.cache_dir() (doc 13 §6/H-4, 09 §11 Y-3):
# ${XDG_CACHE_HOME:-~/.cache}/self-learn/home-<sha256(resolved home)[:8]>/
_slug_cache_dir() {
  local base home_str digest
  base="$(_slug_expand_home "${XDG_CACHE_HOME:-~/.cache}")"
  home_str="$(_slug_ledger_home)"
  digest="$(printf '%s' "$home_str" | sha256sum | cut -c1-8)"
  printf '%s/self-learn/home-%s' "$base" "$digest"
}

_resolve_token_path() {
  if [[ -n "${XDG_RUNTIME_DIR:-}" ]]; then
    printf '%s/self-learn/ui-token' "$XDG_RUNTIME_DIR"
  else
    printf '%s/ui-token' "$(_slug_cache_dir)"
  fi
}

if [[ "$PRINT_PATHS" == 1 ]]; then
  printf 'cache_dir=%s\n' "$(_slug_cache_dir)"
  printf 'token_path=%s\n' "$(_resolve_token_path)"
  exit 0
fi

# D8: ask the Python-owned verb first; `_resolve_token_path` above is now
# only the FALLBACK (see the step-2 header comment). `_VERB_TOKEN_PATH`
# is left empty (and this returns 1) on every failure mode named in that
# comment — shim absent, non-zero exit, `timeout 4` firing, or JSON that
# doesn't decode to two non-empty fields — so the caller always has a
# real value to fall through to.
#
# Absent-shim posture (deliberate — matches hyprctl/systemctl elsewhere
# in this file): a `self-learn-ui` that simply is not on $PATH degrades
# SILENTLY, zero stderr, same as "hyprctl absent entirely -> skip
# detection" and "systemctl absent entirely -> never wait" above.
#
# D8 gate r1 nit 6: a shim that IS present but fails/times out/answers
# garbage prints the one stderr line — but that loud half is NOT this
# file's own convention (a present-but-wedged hyprctl is ALSO silent
# here: every `"${_TO[@]}" hyprctl ...` call above falls through to
# `|| return 0`/`|| true` with zero stderr). The loud half is mandated by
# the D8 pinned decision that the opener must say so when it falls back
# from a present-but-broken verb — do not "fix" this asymmetry by making
# the hyprctl/systemctl sites loud too, or by making this one silent.
_VERB_TOKEN_PATH=""

_try_verb_paths() {
  local out
  command -v self-learn-ui >/dev/null 2>&1 || return 1
  # D8 gate r1 finding 3: `jq` guarded the same way `_ui_window_address`
  # and `_window_monitor_name` already guard it -- silent, matching the
  # absent-dependency posture those two argue for -- so a `jq`-less host
  # falls back BEFORE the shim ever runs, instead of running it, failing
  # to parse its output, and printing a message that blames the shim for
  # a missing parser.
  command -v jq >/dev/null 2>&1 || return 1
  out="$("${_TO[@]}" self-learn-ui paths --json 2>/dev/null)" || {
    echo "self-learn-ui-open: 'self-learn-ui paths' failed or timed out -- falling back to the built-in path mirror" >&2
    return 1
  }
  local verb_cache_dir verb_token_path
  verb_cache_dir="$(jq -r '.cache_dir // empty' 2>/dev/null <<<"$out")" || true
  verb_token_path="$(jq -r '.token_path // empty' 2>/dev/null <<<"$out")" || true
  if [[ -z "$verb_cache_dir" || -z "$verb_token_path" ]]; then
    echo "self-learn-ui-open: 'self-learn-ui paths' returned unparsable output -- falling back to the built-in path mirror" >&2
    return 1
  fi
  _VERB_TOKEN_PATH="$verb_token_path"
  return 0
}

if _try_verb_paths; then
  TOKEN_PATH="$_VERB_TOKEN_PATH"
else
  TOKEN_PATH="$(_resolve_token_path)"
fi
PORT="${SELF_LEARN_UI_PORT:-7357}"

# --- 1. ensure the service is up + Y-14 readiness wait (09 §3) -----------
_PRE_STATE="absent"   # systemctl absent entirely -> never wait (10 §5)
_PRE_TOKEN=""
_START_OK=0
if command -v systemctl >/dev/null 2>&1; then
  # is-active prints the state word (active/inactive/failed/activating/
  # deactivating) even when it exits non-zero — capture, never gate on rc.
  _PRE_STATE="$("${_TO[@]}" systemctl --user is-active self-learn-ui.service 2>/dev/null || true)"
  if [[ -r "$TOKEN_PATH" ]]; then
    _PRE_TOKEN="$(cat "$TOKEN_PATH" 2>/dev/null || true)"
  fi
  if "${_TO[@]}" systemctl --user start self-learn-ui.service >/dev/null 2>&1; then
    _START_OK=1
  fi
fi

# TCP probe via bash's /dev/tcp — no extra binary; even a request the
# server would 403 proves liveness (the probe never sends bytes).
_port_open() {
  # Subshell: the fd opens and closes with it; exit status IS the
  # connect result.
  ( exec 3<>"/dev/tcp/127.0.0.1/${PORT}" ) 2>/dev/null
}

# Cold start ⟺ snapshot state was anything other than `active` (Y-14:
# failed/activating/deactivating are cold starts too — a click landing
# in an idle-exit shutdown drain must wait for the NEW instance's
# token). One shared ≤5 s budget across both phases: fresh token, THEN
# TCP connect (the server writes the token before binding, so
# freshness alone can release into connection-refused). An unchanged
# token WITH a successful connect also counts as ready (delta R2, the
# double-click case: a second launcher snapshots the already-fresh
# token — waiting for a change would burn the whole budget). Timeout:
# fall through with whatever is readable — the 403 page names this
# script as the fix, same as today.
if [[ "$_PRE_STATE" != "active" && "$_START_OK" == 1 ]]; then
  _i=0
  while (( _i < 50 )); do
    if [[ -r "$TOKEN_PATH" ]]; then
      _now_token="$(cat "$TOKEN_PATH" 2>/dev/null || true)"
      if [[ -n "$_now_token" && "$_now_token" != "$_PRE_TOKEN" ]]; then
        break  # fresh token — phase 2 (connect) continues on the same budget
      fi
    fi
    if _port_open; then
      break  # R2: server is up and serving on the snapshot token
    fi
    sleep 0.1
    _i=$(( _i + 1 ))
  done
  while (( _i < 50 )); do
    if _port_open; then
      break
    fi
    sleep 0.1
    _i=$(( _i + 1 ))
  done
fi

TOKEN=""
if [[ -r "$TOKEN_PATH" ]]; then
  TOKEN="$(cat "$TOKEN_PATH")"
fi

# --- URL shape (10 §1 "Companion scripts" row) --------------------------
if [[ -n "$RECORD_ID" ]]; then
  URL="http://127.0.0.1:${PORT}/record/${RECORD_ID}"
else
  URL="http://127.0.0.1:${PORT}/"
fi
if [[ -n "$TOKEN" ]]; then
  URL="${URL}?token=${TOKEN}"
fi

# --- 3/4. window-presence detection + launch -----------------------------
# The window's app_id is matched TWO ways (T-D live trial, 2026-07-17):
# the pinned WINDOW_CLASS (works when chromium launches fresh and honors
# --class), OR the page-title prefix "self-learn — " (the server sets it
# on every page; robust when chromium is ALREADY running and derives the
# app_id from the URL as `chrome-<host>__…-Default`, ignoring --class —
# a native-Wayland chromium behavior that defeats a class-only match).
# The title match focuses an existing UI window regardless of class; a
# deep-link to a *different* record still opens correctly (a new window if
# no reuse) — 09 §5's "new window each time" degradation, not a failure.
_TITLE_PREFIX="self-learn — "
# Resolve the ADDRESS of an existing UI window (empty string if none).
# Matching a window and focusing it must BOTH key off `hyprctl clients -j`,
# never off `hyprctl dispatch focuswindow`'s exit code: on a missing window
# that dispatch prints "No such window found" and STILL exits 0 (X-3, the
# header pin) — so `focuswindow class:… || focuswindow title:…` would
# short-circuit on the always-0 first call and never try the title branch.
# We instead find the address here and focus by address, unambiguously.
_ui_window_address() {
  command -v jq >/dev/null 2>&1 || return 0
  local clients
  # C22: bounded — a wedged compositor must not hang the launcher.
  clients="$("${_TO[@]}" hyprctl clients -j 2>/dev/null)" || return 0
  # `|| true`: hyprctl can exit 0 yet print non-JSON (review F1, delta
  # round: jq then exits 5, and under set -e a bare pipeline here kills
  # the whole launcher from inside $() — at the presence check AND ×50
  # in the placement poll). Unparseable output = "no window", degrade.
  jq -r --arg cls "$WINDOW_CLASS" --arg tp "$_TITLE_PREFIX" \
    'first(.[]? | select(.class == $cls or (.title // "" | startswith($tp))) | .address) // ""' \
    2>/dev/null <<<"$clients" || true
}

# --- 5. monitor placement (feedback round 2 item 6; 09 §4.4) -------------
# $SELF_LEARN_UI_MONITOR is launcher-only, exactly like
# $SELF_LEARN_UI_BROWSER (X-1): the server never reads it, and the value
# is host-specific — the user's own monitor rule is wired host-side
# (environment.d) after merge, never hardcoded in the product.
_MONITOR="${SELF_LEARN_UI_MONITOR:-}"

# Name of the monitor currently holding window $1 (empty = unknown).
# `hyprctl clients -j`'s `monitor` field is a NUMERIC id, not a name —
# map it through `hyprctl monitors -j` .id -> .name. Any gap (jq absent,
# hyprctl error, non-numeric id) prints nothing; callers treat "" as
# unknown and move unconditionally (the move is idempotent).
_window_monitor_name() {
  command -v jq >/dev/null 2>&1 || return 0
  local clients monitors mon_id
  # C22: bounded — a wedged compositor must not hang the launcher.
  clients="$("${_TO[@]}" hyprctl clients -j 2>/dev/null)" || return 0
  mon_id="$(jq -r --arg addr "$1" \
    'first(.[]? | select(.address == $addr) | .monitor) // ""' \
    2>/dev/null <<<"$clients" || true)"
  case "$mon_id" in '' | *[!0-9]*) return 0 ;; esac
  monitors="$("${_TO[@]}" hyprctl monitors -j 2>/dev/null)" || return 0
  jq -r --argjson id "$mon_id" \
    'first(.[]? | select(.id == $id) | .name) // ""' \
    2>/dev/null <<<"$monitors" || true
}

# Ensure window $1 sits on $_MONITOR. Already there (cheap clients -j /
# monitors -j read) -> zero dispatches. Otherwise focuswindow BY ADDRESS
# then `movewindow mon:<name>` — movewindow acts on the focused window,
# so the pair stays adjacent with nothing between. X-3 holds: both
# dispatches are fire-and-forget, their exit codes never branched on.
_ensure_on_monitor() {
  [[ -n "$_MONITOR" && -n "${1:-}" ]] || return 0
  [[ "$(_window_monitor_name "$1")" == "$_MONITOR" ]] && return 0
  # C22: bounded — a wedged compositor must not hang the launcher.
  "${_TO[@]}" hyprctl dispatch focuswindow "address:${1}" >/dev/null 2>&1 || true
  # Stale-address gate (review F2): the window can vanish between the
  # address resolve and this dispatch, in which case the focus lands
  # nowhere and movewindow would relocate whatever UNRELATED window the
  # user has focused. Confirm OUR address actually holds focus by
  # reading `hyprctl activewindow -j` — a JSON read, never an rc branch
  # (X-3) — and skip the move on any mismatch or gap (degrade).
  local active active_addr
  # C22: bounded — a wedged compositor must not hang the launcher.
  active="$("${_TO[@]}" hyprctl activewindow -j 2>/dev/null)" || return 0
  active_addr="$(jq -r '.address // ""' 2>/dev/null <<<"$active" || true)"
  [[ "$active_addr" == "$1" ]] || return 0
  # C22: bounded — a wedged compositor must not hang the launcher.
  "${_TO[@]}" hyprctl dispatch movewindow "mon:${_MONITOR}" >/dev/null 2>&1 || true
}

# Fresh-launch placement: the window takes time to appear, so poll the
# SAME `_ui_window_address` match (class OR title prefix) on a one ≤5 s
# WALL-CLOCK budget, 0.1 s poll steps — then place; give up SILENTLY on
# timeout (degrade to compositor placement, never an error). Monitor
# unset — or jq absent, where the address can never resolve — skips the
# poll entirely: the fast path stays fast.
#
# Fold r1 m3: this used to be a fixed 50-ITERATION count, which really
# was a ≤5 s budget back when each iteration cost only a 0.1 s sleep —
# but `_ui_window_address` now wraps its own `hyprctl clients -j` call in
# `"${_TO[@]}"` (C22), so a wedged compositor can make ONE iteration cost
# up to 4 s. 50 such iterations is ≈205 s, not ≤5 s. A `SECONDS`-based
# wall-clock deadline bounds the WHOLE loop regardless of how expensive
# any single iteration turns out to be.
_place_fresh_window() {
  [[ -n "$_MONITOR" ]] || return 0
  command -v jq >/dev/null 2>&1 || return 0
  local _addr="" _deadline=$(( SECONDS + 5 ))
  while (( SECONDS < _deadline )); do
    # `|| _addr=""` is belt only (review F1) — the jq inside
    # _ui_window_address is already `|| true`-guarded at the source.
    _addr="$(_ui_window_address)" || _addr=""
    [[ -n "$_addr" ]] && break
    sleep 0.1
  done
  [[ -n "$_addr" ]] || return 0
  _ensure_on_monitor "$_addr"
}

_resolve_browser() {
  local candidate
  for candidate in "${SELF_LEARN_UI_BROWSER:-}" chromium google-chrome-stable; do
    [[ -z "$candidate" ]] && continue
    if command -v "$candidate" >/dev/null 2>&1; then
      printf '%s' "$candidate"
      return 0
    fi
  done
  return 1
}

_launch() {
  local browser
  if browser="$(_resolve_browser)"; then
    "$browser" "--app=${URL}" "--class=${WINDOW_CLASS}" >/dev/null 2>&1 &
    disown 2>/dev/null || true
  else
    xdg-open "$URL" >/dev/null 2>&1 &
    disown 2>/dev/null || true
  fi
}

if command -v hyprctl >/dev/null 2>&1; then
  _ui_addr="$(_ui_window_address)"
  if [[ -n "$_ui_addr" ]]; then
    # Focus the matched window by ADDRESS (works whether the class is the
    # pinned one or the URL-derived chromium-Wayland form — T-D fix).
    # C22: bounded — a wedged compositor must not hang the launcher.
    "${_TO[@]}" hyprctl dispatch focuswindow "address:${_ui_addr}" >/dev/null 2>&1 || true
    _ensure_on_monitor "$_ui_addr"
  else
    _launch
    _place_fresh_window
  fi
else
  # hyprctl absent: no detection AND no placement — $SELF_LEARN_UI_MONITOR
  # is a hyprctl-mediated concern by definition (header step 5).
  _launch
fi
