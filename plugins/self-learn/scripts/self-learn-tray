#!/usr/bin/python3 -I
"""self-learn-tray: the self-learn tray icon (StatusNotifierItem, Gio only).

It shows what `self-learn attention --json` says (attention-design-r2 §3.5,
§3.10, §4.1): idle (grey, always shown), new (a flagged decided item you have
not seen), needs-you, or broken. A left click opens the inbox; a middle click
marks every decided item seen; a right click opens a menu (com.canonical.dbusmenu)
with the same two actions and open, check now, restart and quit (09 §2.6). It
never reads the ledger itself and never runs git: it runs `timeout 10 self-learn attention --json` every 120 s, and at once
when `$SELF_LEARN_HOME` itself (not recursively: a typed reply's statement
lands in `user-statements.jsonl` there), `$SELF_LEARN_HOME/overseer/`,
`$SELF_LEARN_HOME/attention/` or `<cache_dir>/attention/` changes (`cache_dir`
comes from the JSON).

The system python (`-I`) because the uv venv has no `gi`; Gio only (no Gtk, so
no display is needed). Deployed by install.sh, run by self-learn-tray.service.

`--pure poll|activate|secondary|menu|click` runs one step without the session
bus and prints JSON; the tests use it (`tests/test_tray.py`).
"""

import argparse
import json
import math
import os
import signal
import sys
import time

import gi

gi.require_version("Gio", "2.0")
from gi.repository import Gio, GLib  # noqa: E402

POLL_SECS = 120
TIMEOUT_SECS = 10
TIMED_OUT = 124  # timeout(1)'s exit status when the command ran out of time
ICON_DIR = os.path.join(os.path.dirname(os.path.dirname(os.path.realpath(__file__))), "assets", "tray")
STATES = ("idle", "new", "needs-you", "broken")
STATUS = {"idle": "Passive", "new": "Active", "needs-you": "NeedsAttention", "broken": "NeedsAttention"}
# `--scope`, not a transient service: the launcher backgrounds the browser
# and exits, and a service's exit kills everything left in its cgroup, so a
# freshly started browser died with it (2026-11-01). A scope lives on while
# the browser runs, outside the tray's own cgroup.
ACTIVATE_ARGV = ["systemd-run", "--user", "--scope", "--collect", "--quiet", "--", "self-learn-ui-open", "--page", "/inbox"]
SECONDARY_ARGV = ["self-learn", "attention", "seen", "--all-decided"]
# The right-click menu (09 §2.6). Open runs the launcher with no page: it
# focuses an open UI window or opens Home. The UI restart is immediate; the
# background service uses a scheduler request so jobs finish before re-exec.
# Quit stops this unit: a plain exit would come back in 5 s
# (Restart=always), and `--no-block` because systemd stops this process.
OPEN_ARGV = ["systemd-run", "--user", "--scope", "--collect", "--quiet", "--", "self-learn-ui-open"]
RESTART_UI_ARGV = ["systemctl", "--user", "restart", "self-learn-ui.service"]
START_HOST_ARGV = ["systemctl", "--user", "start", "self-learn-host.service"]
# Offered only while a background restart is waiting for a job that may never
# end: a plain systemd restart, which stops the running job (SIGTERM, then a
# kill after the unit's 90 s stop timeout), so it gets a longer bound.
FORCE_HOST_ARGV = ["systemctl", "--user", "restart", "self-learn-host.service"]
QUIT_ARGV = ["systemctl", "--user", "--no-block", "stop", "self-learn-tray.service"]
HOST_ACTIVE_ARGV = ["systemctl", "--user", "is-active", "--quiet", "self-learn-host.service"]
RESTART_REQUEST_ARGV = ["self-learn", "serve", "--restart"]
RESTART_WATCH_SECS = 3 * 3600
WAIT_SECS = 5
CONTROL_TIMEOUT_SECS = None  # hidden test-only override; production limits below
BROKEN_TITLE = "self-learn: could not check what needs you"
WATCH_EVENTS = {
    Gio.FileMonitorEvent.CHANGES_DONE_HINT, Gio.FileMonitorEvent.CREATED, Gio.FileMonitorEvent.DELETED,
    Gio.FileMonitorEvent.MOVED_IN, Gio.FileMonitorEvent.MOVED_OUT, Gio.FileMonitorEvent.RENAMED,
}


def log(msg):
    print(f"self-learn-tray: {msg}", file=sys.stderr, flush=True)


def ledger_home():
    """As the unit pins it; `~/.self-learn` when unset (critique 30)."""
    return os.path.expanduser(os.environ.get("SELF_LEARN_HOME") or "~/.self-learn")


def poll_argv(timeout_secs=TIMEOUT_SECS):
    return ["timeout", "--kill-after=5", str(timeout_secs), "self-learn", "attention", "--json"]


def interpret(rc, stdout, stderr, timeout_secs=TIMEOUT_SECS):
    """One `attention --json` result -> {state, tooltip, error, cache_dir}.

    A timeout, a non-zero exit or output that is not the contract's JSON is
    `broken`, with the error in the tooltip. The tray never re-derives the
    state from the items: `state` is the reader's (one copy of the rule)."""
    data, problem = None, None
    try:
        data = json.loads(stdout or "")
        if not isinstance(data, dict):
            data, problem = None, "not a JSON object"
    except ValueError as exc:
        problem = f"not JSON ({exc})"
    cache_dir = data.get("cache_dir") if data else None
    cache_dir = cache_dir if isinstance(cache_dir, str) and cache_dir else None
    last = (stderr or "").strip().splitlines()[-1:] or [""]
    # The tooltip title says what failed (BROKEN_TITLE); this is the reason, in plain words.
    if rc == TIMED_OUT:
        error = f"it did not answer within {timeout_secs} s"
    elif rc == -signal.SIGKILL or rc == 128 + signal.SIGKILL:
        error = f"it was stopped before it answered (it ran past {timeout_secs} s, or the system killed it)"
    elif rc != 0:
        reason = (data or {}).get("error") or last[0] or problem or "no message"
        error = f"{reason} (exit {rc})"
    elif data is None:
        error = f"its output was not readable: {problem}"
    elif data.get("state") not in STATES:
        error = f"it reported a state the tray does not know: {data.get('state')!r}"
    else:
        tooltip = data.get("tooltip") if isinstance(data.get("tooltip"), str) else ""
        return {"state": data["state"], "tooltip": tooltip or "self-learn", "error": None, "cache_dir": cache_dir}
    return {"state": "broken", "tooltip": BROKEN_TITLE, "error": error, "cache_dir": cache_dir}


def sni_view(result):
    """The SNI face of one result: Status, IconName, ToolTip (title, description)."""
    state = result["state"]
    icon = f"self-learn-tray-{state}"
    return {"state": state, "status": STATUS[state], "icon_name": icon, "attention_icon_name": icon,
            "tooltip_title": result["tooltip"], "tooltip_description": result["error"] or ""}


def watch_dirs(home, cache_dir):
    # A directory monitor is not recursive. The ledger root itself is watched so
    # that a reply typed in the workspace (a statement appended to
    # `user-statements.jsonl` there, design r2 §3.4.1) polls at once; changes
    # inside `.git/`, `cases/` and the other subdirectories fire nothing here.
    dirs = [home, os.path.join(home, "overseer"), os.path.join(home, "attention")]
    if cache_dir:
        dirs.append(os.path.join(cache_dir, "attention"))
    return dirs


def finite_epoch(value):
    try:
        return type(value) in (int, float) and math.isfinite(value) and value > 0
    except OverflowError:
        return False


def restart_receipt(text):
    try:
        data = json.loads(text)
        if (isinstance(data, dict) and data.get("requested") is True
                and isinstance(data.get("id"), str) and data["id"].strip()
                and isinstance(data.get("result_path"), str)
                and os.path.isabs(data["result_path"]) and "\0" not in data["result_path"]):
            return data
    except (ValueError, TypeError):
        pass
    return None


def restart_outcome(path, request_id):
    try:
        with open(path, encoding="utf-8") as fh:
            data = json.load(fh)
        if (isinstance(data, dict) and data.get("id") == request_id
                and isinstance(data.get("status"), str)
                and data["status"] in ("restarting", "restarted", "refused")
                and finite_epoch(data.get("at")) and "error" in data
                and (data["error"] is None or isinstance(data["error"], str))
                and (data["status"] != "refused" or bool(data["error"]))):
            return data
    except (OSError, ValueError, TypeError):
        pass
    return None


# The menu's items in order: (id, action key, label). Ids are dbusmenu ids
# (0 is the root); a key of None is a separator, "status" the state line.
MENU = (
    (1, "status", None),
    (2, None, None),
    (3, "open-inbox", "Open the inbox"),
    (4, "open", "Open self-learn"),
    (5, None, None),
    (6, "check", "Check now"),
    (7, "seen", "Mark everything decided as seen"),
    (8, None, None),
    (9, "restart-ui", "Restart the web UI"),
    (10, "restart-host", "Restart the background service"),
    (13, "force-restart-host", "Force restart now (stops the running job)"),
    (11, None, None),
    (12, "quit", "Quit (hide this icon until next login)"),
)
MENU_KEYS = {key: mid for mid, key, _label in MENU if key and key != "status"}


def menu_items(result, restarting, host_waiting=False):
    """Both restart items stay disabled until their outstanding operation ends.
    The force restart is listed only while a background restart request is
    waiting for the service to be between jobs."""
    items = []
    for mid, key, label in MENU:
        if key is None:
            items.append({"id": mid, "key": None, "type": "separator", "label": "", "enabled": True})
            continue
        enabled = True
        if key == "force-restart-host":
            if not (host_waiting or key in restarting):
                continue
            if key in restarting:
                label, enabled = "Force restarting the background service…", False
        elif key == "status":
            label, enabled = result["tooltip"], False
        elif key in restarting:
            what = "background service" if key == "restart-host" else "web UI"
            label, enabled = f"Restarting the {what}…", False
        items.append({"id": mid, "key": key, "type": "standard", "label": label, "enabled": enabled})
    return items


def control_argv(argv):
    """Bound only the tray's command process, never the background host. The
    two launchers are not bounded: GNU timeout signals its whole process group,
    and a browser the launcher started stays in that group."""
    if argv in (ACTIVATE_ARGV, OPEN_ARGV):
        return argv
    if argv == HOST_ACTIVE_ARGV:
        secs = 15
    elif argv == FORCE_HOST_ARGV:
        secs = 180  # the unit's 90 s stop timeout, then the start
    elif argv[0] == "systemctl" and ("start" in argv or "restart" in argv):
        secs = 120
    else:
        secs = 30
    return ["timeout", "--kill-after=5", str(CONTROL_TIMEOUT_SECS or secs), *argv]


def command_timed_out(rc):
    return rc in (124, 137) or rc < 0


def spawn(argv, done=None):
    """Start argv without blocking the main loop; `done(rc)` when it exits."""
    try:
        proc = Gio.Subprocess.new(control_argv(argv), Gio.SubprocessFlags.NONE)
    except GLib.Error as exc:
        log(f"could not start {argv[0]}: {exc.message}")
        if done:
            done(127)
        return

    def finished(p, res):
        try:
            p.wait_finish(res)
            rc = p.get_exit_status() if p.get_if_exited() else -p.get_term_sig()
        except GLib.Error as exc:
            log(f"{argv[0]}: {exc.message}")
            rc = 1
        if rc != 0:
            log(f"{' '.join(argv)} exited {rc}")
        if done:
            done(rc)

    proc.wait_async(None, finished)


def capture(argv, done):
    """Read a command's JSON asynchronously; never block the menu's bus thread."""
    try:
        proc = Gio.Subprocess.new(control_argv(argv), Gio.SubprocessFlags.STDOUT_PIPE | Gio.SubprocessFlags.STDERR_PIPE)
    except GLib.Error as exc:
        done(127, "", exc.message)
        return

    def finished(p, res):
        try:
            _ok, stdout, stderr = p.communicate_utf8_finish(res)
            rc = p.get_exit_status() if p.get_if_exited() else -p.get_term_sig()
        except GLib.Error as exc:
            done(1, "", exc.message)
            return
        done(rc, stdout or "", stderr or "")

    proc.communicate_utf8_async(None, None, finished)


class Tray:
    """State, polling and file monitors. The D-Bus face is `SniItem`."""

    def __init__(self, on_change=None, timeout_secs=TIMEOUT_SECS, notify=None, wait_secs=WAIT_SECS):
        self.home = ledger_home()
        self.timeout_secs = timeout_secs
        self.on_change = on_change
        self.notify = notify or (lambda summary, body: log(f"{summary} {body}".strip()))
        self.wait_secs = wait_secs
        self.restarting = set()
        self.host_wait = None  # the background restart request being watched, if any
        self.result = {"state": "idle", "tooltip": "self-learn: checking…", "error": None, "cache_dir": None}
        self.cache_dir = None
        self.monitors = {}
        self.polling = False
        self.again = False
        self.quiet_until = 0
        self.pending = 0
        self.rewatch()

    def rewatch(self):
        wanted = watch_dirs(self.home, self.cache_dir)
        for path in list(self.monitors):
            if path not in wanted:
                self.monitors.pop(path).cancel()
        for path in wanted:
            if path in self.monitors:
                continue
            try:
                mon = Gio.File.new_for_path(path).monitor_directory(Gio.FileMonitorFlags.WATCH_MOVES, None)
            except GLib.Error as exc:
                log(f"cannot watch {path}: {exc.message}")
                continue
            mon.connect("changed", self.on_file_event)
            self.monitors[path] = mon

    def on_file_event(self, _mon, _file, _other, event):
        # A change made while our own poll runs (the reader's cache write) or
        # just after it is not a reason to poll again; the 120 s poll is the
        # backstop for a change that lands in that window.
        if event not in WATCH_EVENTS or self.polling or GLib.get_monotonic_time() < self.quiet_until:
            return
        if not self.pending:
            self.pending = GLib.timeout_add(1000, self.poll_from_timer)

    def poll_from_timer(self):
        self.pending = 0
        self.poll()
        return False

    def poll(self, done=None):
        if self.polling:
            self.again = True
            return
        self.polling = True
        argv = poll_argv(self.timeout_secs)
        try:
            proc = Gio.Subprocess.new(argv, Gio.SubprocessFlags.STDOUT_PIPE | Gio.SubprocessFlags.STDERR_PIPE)
        except GLib.Error as exc:
            self.finish({"state": "broken", "tooltip": BROKEN_TITLE,
                         "error": f"could not run {argv[0]}: {exc.message}", "cache_dir": None}, done)
            return

        def answered(p, res):
            try:
                _ok, out, err = p.communicate_utf8_finish(res)
                rc = p.get_exit_status() if p.get_if_exited() else -p.get_term_sig()
            except GLib.Error as exc:
                out, err, rc = "", exc.message, 1
            self.finish(interpret(rc, out, err, self.timeout_secs), done)

        proc.communicate_utf8_async(None, None, answered)

    def finish(self, result, done):
        self.polling = False
        self.quiet_until = GLib.get_monotonic_time() + 1_000_000
        if result["error"]:
            log(f"self-learn attention --json: {result['error']}")
        if result["cache_dir"] and result["cache_dir"] != self.cache_dir:
            self.cache_dir = result["cache_dir"]
            self.rewatch()
        changed = result != self.result
        self.result = result
        if changed and self.on_change:
            self.on_change()
        if done:
            done()
        if self.again:
            self.again = False
            self.poll()

    def activate(self, done=None):
        spawn(ACTIVATE_ARGV, done)

    def secondary(self, done=None):
        """Mark every decided item seen, then poll so the icon drops `new` at once."""
        spawn(SECONDARY_ARGV, lambda rc: self.poll(done=(lambda: done(rc)) if done else None))

    def menu(self):
        return menu_items(self.result, self.restarting, self.host_wait is not None)

    def changed(self):
        if self.on_change:
            self.on_change()

    def click(self, key, done=None):
        """One menu item; `done(rc)` when its command has exited."""
        done = done or (lambda _rc: None)
        if key in ("restart-ui", "restart-host", "force-restart-host"):
            if key in self.restarting:
                return
            self.restarting.add(key)
            self.changed()
            completed = done

            def done(rc):
                self.restarting.discard(key)
                self.changed()
                completed(rc)

        if key == "open-inbox":
            self.activate(done)
        elif key == "open":
            spawn(OPEN_ARGV, done)
        elif key == "check":
            self.poll(done=lambda: done(0))
        elif key == "seen":
            self.secondary(done)
        elif key == "restart-ui":
            self.restart(RESTART_UI_ARGV, "web UI", done)
        elif key == "restart-host":
            self.restart_host(done)
        elif key == "force-restart-host":
            self.force_restart_host(done)
        elif key == "quit":
            spawn(QUIT_ARGV, done)
        else:
            log(f"no menu item {key!r}")
            done(2)

    def restart(self, argv, what, done, *, start=False):
        verb, past = ("start", "started") if start else ("restart", "restarted")

        def ran(rc):
            if rc == 0:
                self.notify(f"self-learn: the {what} {past}", "")
            elif command_timed_out(rc):
                self.notify(f"self-learn: could not confirm the {what} {verb}",
                            "The command timed out or was killed; the operation may still complete.")
            else:
                self.notify(f"self-learn: could not {verb} the {what}", f"systemctl exited {rc}; see its journal.")
            done(rc)
        spawn(argv, ran)

    def restart_host(self, done):
        def requested(rc, stdout, stderr):
            if command_timed_out(rc):
                self.notify("self-learn: background restart request timed out",
                            "It is not known whether the request was recorded; the service may still restart.")
                done(rc)
                return
            receipt = restart_receipt(stdout) if rc == 0 else None
            if receipt is None:
                self.notify("self-learn: could not request a background restart",
                            stderr.strip() or f"Invalid restart receipt (exit {rc}).")
                done(rc or 1)
                return
            self.notify("self-learn: restart waiting",
                        "The background service will restart as soon as it is between jobs. "
                        "If a job is stuck, the menu now offers a force restart.")
            deadline = time.monotonic() + RESTART_WATCH_SECS
            wait = {"done": done, "over": False}
            self.host_wait = wait
            self.changed()

            def finish(rc):
                if wait["over"]:
                    return
                wait["over"] = True
                if self.host_wait is wait:
                    self.host_wait = None
                done(rc)

            wait["finish"] = finish

            def check():
                if wait["over"]:
                    return False  # a force restart ended this wait
                result = restart_outcome(receipt["result_path"], receipt["id"])
                if result is not None and result["status"] != "restarting":
                    if result["status"] == "restarted":
                        self.notify("self-learn: the background service restarted", "")
                        finish(0)
                    else:
                        self.notify("self-learn: could not restart the background service", result["error"])
                        finish(1)
                    return False
                if time.monotonic() >= deadline:
                    self.notify("self-learn: restart still waiting",
                                "The request is still waiting after 3 hours; it has not been cancelled. "
                                "If a job is stuck, use Force restart in the menu.")
                    finish(1)
                    return False
                return True

            GLib.timeout_add_seconds(self.wait_secs, check)

        def active(rc):
            if command_timed_out(rc):
                self.notify("self-learn: could not check the background service",
                            "The status command timed out or was killed; no start or restart was requested.")
                done(rc)
            elif rc == 0:
                capture(RESTART_REQUEST_ARGV, requested)
            else:
                self.restart(START_HOST_ARGV, "background service", done, start=True)

        spawn(HOST_ACTIVE_ARGV, active)

    def force_restart_host(self, done):
        """Restart the background service through systemd now, stopping a job
        that never ends. Only while a request is waiting: then the waiting
        restart is over too (the fresh process takes the request left behind
        and re-execs once more, idle). On failure the request keeps waiting."""
        wait = self.host_wait
        if wait is None:
            log("force restart: no background restart is waiting")
            done(2)
            return

        def ran(rc):
            if rc == 0:
                wait["finish"](0)
            done(rc)

        self.restart(FORCE_HOST_ARGV, "background service", ran)


