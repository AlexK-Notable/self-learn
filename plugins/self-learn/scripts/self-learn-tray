def menu_props(item):
    """One item's dbusmenu properties. An underscore in a label marks an access
    key in dbusmenu, so a literal one is doubled."""
    if item["type"] == "separator":
        return {"type": GLib.Variant("s", "separator")}
    return {"label": GLib.Variant("s", item["label"].replace("_", "__")),
            "enabled": GLib.Variant("b", item["enabled"]), "visible": GLib.Variant("b", True)}


class MenuServer:
    """com.canonical.dbusmenu at MENU_PATH: one flat level under the root (id 0).
    The layout is built from the tray's state at each call; a change bumps the
    revision and emits LayoutUpdated so the host fetches it again."""

    def __init__(self, tray):
        self.tray = tray
        self.conn = None
        self.revision = 1
        self.published = None
        self.iface = Gio.DBusNodeInfo.new_for_xml(MENU_XML).interfaces[0]

    def attach(self, conn):
        self.conn = conn
        conn.register_object(MENU_PATH, self.iface, self.on_call, self.on_get, None)

    def items(self):
        return {item["id"]: item for item in self.tray.menu()}

    def refresh(self):
        """Emit LayoutUpdated when the menu differs from the one last published; True if it did."""
        items = self.items()
        if items == self.published:
            return False
        self.revision += 1
        self.published = items
        if self.conn is not None:
            self.conn.emit_signal(None, MENU_PATH, MENU_IFACE, "LayoutUpdated", GLib.Variant("(ui)", (self.revision, 0)))
        return True

    def on_get(self, _conn, _sender, _path, _iface, prop):
        values = {"Version": ("u", 3), "TextDirection": ("s", "ltr"), "Status": ("s", "normal"),
                  "IconThemePath": ("as", [ICON_DIR])}
        sig, value = values[prop]
        return GLib.Variant(sig, value)

    @staticmethod
    def pick(props, names):
        return {k: v for k, v in props.items() if not names or k in names}

    def node(self, mid, items, depth, names):
        if mid == 0:
            props = {"children-display": GLib.Variant("s", "submenu")}
            kids = [] if depth == 0 else [GLib.Variant("(ia{sv}av)", self.node(i, items, 0, names)) for i in items]
            return (0, self.pick(props, names), kids)
        return (mid, self.pick(menu_props(items[mid]), names), [])

    def on_call(self, _conn, _sender, _path, _iface, method, params, inv):
        items = self.items()
        args = params.unpack()
        if method == "GetLayout":
            parent, depth, names = args
            if parent != 0 and parent not in items:
                inv.return_dbus_error("com.canonical.dbusmenu.Error.UnknownId", f"no menu item {parent}")
                return
            inv.return_value(GLib.Variant("(u(ia{sv}av))", (self.revision, self.node(parent, items, depth, names))))
        elif method == "GetGroupProperties":
            ids, names = args
            ids = ids or [0, *items]
            out = [(i, self.pick({"children-display": GLib.Variant("s", "submenu")} if i == 0
                                 else menu_props(items[i]), names)) for i in ids if i == 0 or i in items]
            inv.return_value(GLib.Variant("(a(ia{sv}))", (out,)))
        elif method == "GetProperty":
            mid, name = args
            props = ({"children-display": GLib.Variant("s", "submenu")} if mid == 0
                     else menu_props(items[mid]) if mid in items else {})
            if name not in props:
                inv.return_dbus_error("com.canonical.dbusmenu.Error.UnknownProperty", f"{mid} has no {name}")
                return
            inv.return_value(GLib.Variant("(v)", (props[name],)))
        elif method == "Event":
            mid, event, _data, _ts = args
            self.event(mid, event, items)
            inv.return_value(None)
        elif method == "EventGroup":
            events = args[0]
            valid = [mid for mid, *_ in events if mid == 0 or mid in items]
            if not valid:
                inv.return_dbus_error("com.canonical.dbusmenu.Error.UnknownId", "no known menu ids")
                return
            errors = [mid for mid, event, _data, _ts in events if not self.event(mid, event, items)]
            inv.return_value(GLib.Variant("(ai)", (errors,)))
        elif method in ("AboutToShow", "AboutToShowGroup"):
            ids = [args[0]] if method == "AboutToShow" else args[0]
            valid = [mid for mid in ids if mid == 0 or mid in items]
            errors = [mid for mid in ids if mid != 0 and mid not in items]
            if not valid:
                inv.return_dbus_error("com.canonical.dbusmenu.Error.UnknownId", "no known menu ids")
                return
            changed = self.refresh()
            if method == "AboutToShow":
                inv.return_value(GLib.Variant("(b)", (changed,)))
            else:
                inv.return_value(GLib.Variant("(aiai)", (valid if changed else [], errors)))
        else:
            inv.return_dbus_error("org.freedesktop.DBus.Error.UnknownMethod", method)

    def event(self, mid, event, items):
        """True when `mid` is an item. Only "clicked" on an enabled item acts."""
        if mid != 0 and mid not in items:
            return False
        item = items.get(mid)
        if event == "clicked" and item and item["enabled"] and item["key"] in MENU_KEYS:
            self.tray.click(item["key"])
        return True


class SniItem:
    """The StatusNotifierItem on the session bus; registers again whenever the
    watcher (Waybar) appears or changes owner."""

    def __init__(self, loop, poll_secs=POLL_SECS):
        self.loop = loop
        self.poll_secs = poll_secs
        self.exit_code = 0
        self.name = f"org.kde.StatusNotifierItem-{os.getpid()}-1"
        self.conn = None
        self.owned = False
        self.watcher = None
        self.shown = None
        self.iface = Gio.DBusNodeInfo.new_for_xml(SNI_XML).interfaces[0]
        self.tray = Tray(on_change=self.publish, notify=self.notify)
        self.menu = MenuServer(self.tray)
        Gio.bus_own_name(Gio.BusType.SESSION, self.name, Gio.BusNameOwnerFlags.NONE,
                         self.on_bus, self.on_name, self.on_name_lost)
        Gio.bus_watch_name(Gio.BusType.SESSION, WATCHER, Gio.BusNameWatcherFlags.NONE,
                           self.on_watcher, self.on_watcher_gone)

    def on_bus(self, conn, _name):
        self.conn = conn
        conn.register_object(SNI_PATH, self.iface, self.on_call, self.on_get, None)
        self.menu.attach(conn)

    def on_name(self, _conn, _name):
        self.owned = True
        self.register()
        self.tray.poll()
        GLib.timeout_add_seconds(self.poll_secs, self.tick)

    def tick(self):
        self.tray.poll()
        return True

    def on_name_lost(self, _conn, _name):
        log(f"lost the bus name {self.name} (no session bus?); exiting so systemd restarts the tray")
        self.exit_code = 1
        self.loop.quit()

    def on_watcher(self, _conn, _name, owner):
        self.watcher = owner
        self.register()

    def on_watcher_gone(self, _conn, _name):
        self.watcher = None

    def register(self):
        if not (self.owned and self.watcher and self.conn):
            return

        def done(conn, res):
            try:
                conn.call_finish(res)
                log(f"registered with {WATCHER} ({self.watcher})")
            except GLib.Error as exc:
                log(f"RegisterStatusNotifierItem failed: {exc.message}")

        self.conn.call(WATCHER, "/StatusNotifierWatcher", WATCHER, "RegisterStatusNotifierItem",
                       GLib.Variant("(s)", (self.name,)), None, Gio.DBusCallFlags.NONE, 5000, None, done)

    def view(self):
        return sni_view(self.tray.result)

    def on_get(self, _conn, _sender, _path, _iface, prop):
        v = self.view()
        values = {
            "Category": ("s", "ApplicationStatus"), "Id": ("s", "self-learn"), "Title": ("s", "self-learn"),
            "Status": ("s", v["status"]), "WindowId": ("i", 0), "IconThemePath": ("s", ICON_DIR),
            "IconName": ("s", v["icon_name"]), "IconPixmap": ("a(iiay)", []), "OverlayIconName": ("s", ""),
            "AttentionIconName": ("s", v["attention_icon_name"]), "AttentionIconPixmap": ("a(iiay)", []),
            # Waybar renders the title as markup and escapes the description itself.
            "ToolTip": ("(sa(iiay)ss)", (v["icon_name"], [], GLib.markup_escape_text(v["tooltip_title"]),
                                          v["tooltip_description"])),
            "ItemIsMenu": ("b", False), "Menu": ("o", MENU_PATH),
        }
        sig, value = values[prop]
        return GLib.Variant(sig, value)

    def on_call(self, _conn, _sender, _path, _iface, method, _params, invocation):
        if method == "Activate":
            self.tray.activate()
        elif method == "SecondaryActivate":
            self.tray.secondary()
        invocation.return_value(None)

    def notify(self, summary, body):
        """A desktop notification (org.freedesktop.Notifications); logged as well,
        and a missing notification daemon costs only the popup."""
        log(f"{summary} {body}".strip())
        if self.conn is None:
            return

        def done(conn, res):
            try:
                conn.call_finish(res)
            except GLib.Error as exc:
                log(f"could not show a notification: {exc.message}")

        icon = os.path.join(ICON_DIR, "self-learn-tray-idle.svg")
        self.conn.call(NOTIFY, "/org/freedesktop/Notifications", NOTIFY, "Notify",
                       GLib.Variant("(susssasa{sv}i)", ("self-learn", 0, icon, summary, body, [], {}, -1)),
                       None, Gio.DBusCallFlags.NONE, 5000, None, done)

    def publish(self):
        self.menu.refresh()
        v = self.view()
        if self.conn is None or v == self.shown:
            return
        old, self.shown = self.shown or {}, v
        if v["status"] != old.get("status"):
            self.conn.emit_signal(None, SNI_PATH, SNI_IFACE, "NewStatus", GLib.Variant("(s)", (v["status"],)))
        if v["icon_name"] != old.get("icon_name"):
            self.conn.emit_signal(None, SNI_PATH, SNI_IFACE, "NewIcon", None)
            self.conn.emit_signal(None, SNI_PATH, SNI_IFACE, "NewAttentionIcon", None)
        self.conn.emit_signal(None, SNI_PATH, SNI_IFACE, "NewToolTip", None)


def pure(step, timeout_secs, item=None, wait_secs=WAIT_SECS, then=None, then_after=2.0):
    """One step without the session bus; prints what happened as JSON.
    `menu` polls once and prints the menu; `click` polls once, then runs one
    menu item (`--item`), recording the notifications and every menu it went
    through, and prints the menu after."""
    loop = GLib.MainLoop()
    out = {}
    notices, menus = [], []
    tray = Tray(timeout_secs=timeout_secs, wait_secs=wait_secs,
                notify=lambda summary, body: notices.append([summary, body]))
    tray.on_change = lambda: menus.append(tray.menu())

    if step in ("menu", "click"):
        def after_click(rc):
            out.update(rc=rc, notices=notices, menus=menus, menu=tray.menu())
            GLib.idle_add(loop.quit)

        def polled_first():
            out.update(view=sni_view(tray.result))
            if step == "menu":
                out.update(menu=tray.menu())
                GLib.idle_add(loop.quit)
            else:
                tray.click(item, after_click)
                if then:
                    # A second item, `then_after` seconds into the first (tests only).
                    def second():
                        out.update(then_menu=tray.menu())
                        def then_done(rc):
                            out.update(then_rc=rc, notices=notices, menus=menus)
                            if "rc" not in out:  # the first item is still running: stop soon
                                GLib.timeout_add(500, lambda: (loop.quit(), False)[1])
                        tray.click(then, then_done)
                        return False
                    GLib.timeout_add(int(then_after * 1000), second)

        tray.poll(done=polled_first)
        GLib.timeout_add_seconds(timeout_secs + 15 + 3 * wait_secs, loop.quit)
        loop.run()
        print(json.dumps(out, sort_keys=True))
        return 0

    def polled():
        out.update(view=sni_view(tray.result), error=tray.result["error"],
                   watch=sorted(tray.monitors), home=tray.home, icon_dir=ICON_DIR)
        GLib.idle_add(loop.quit)

    def ran(rc):
        out.update(rc=rc)
        if step == "secondary":
            polled()  # `secondary` calls back after its re-poll
        GLib.idle_add(loop.quit)

    if step == "poll":
        tray.poll(done=polled)
    elif step == "activate":
        tray.activate(done=ran)
    else:
        tray.secondary(done=ran)
    GLib.timeout_add_seconds(timeout_secs + 15, loop.quit)
    loop.run()
    print(json.dumps(out, sort_keys=True))
    return 0


def unix_signal_add(sig, handler):
    """`GLibUnix.signal_add` where this PyGObject has it (newer ones warn on
    `GLib.unix_signal_add`, into the journal at every start), else the old name."""
    try:
        gi.require_version("GLibUnix", "2.0")
        from gi.repository import GLibUnix
        return GLibUnix.signal_add(GLib.PRIORITY_DEFAULT, sig, handler)
    except (ImportError, ValueError, AttributeError):
        return GLib.unix_signal_add(GLib.PRIORITY_DEFAULT, sig, handler)


def main(argv):
    global CONTROL_TIMEOUT_SECS
    ap = argparse.ArgumentParser(prog="self-learn-tray", description=__doc__.splitlines()[0])
    ap.add_argument("--pure", choices=("poll", "activate", "secondary", "menu", "click"),
                    help="run one step without the session bus and print JSON (tests)")
    ap.add_argument("--item", choices=sorted(MENU_KEYS), help="the menu item `--pure click` runs")
    ap.add_argument("--timeout-secs", type=int, default=TIMEOUT_SECS, help=argparse.SUPPRESS)
    ap.add_argument("--wait-secs", type=int, default=WAIT_SECS, help=argparse.SUPPRESS)
    ap.add_argument("--poll-secs", type=int, default=POLL_SECS, help=argparse.SUPPRESS)
    ap.add_argument("--control-timeout-secs", type=float, help=argparse.SUPPRESS)
    ap.add_argument("--then", choices=sorted(MENU_KEYS), help=argparse.SUPPRESS)
    ap.add_argument("--then-after", type=float, default=2.0, help=argparse.SUPPRESS)
    args = ap.parse_args(argv)
    if args.control_timeout_secs is not None:
        if not math.isfinite(args.control_timeout_secs) or args.control_timeout_secs <= 0:
            ap.error("--control-timeout-secs must be finite and positive")
        CONTROL_TIMEOUT_SECS = args.control_timeout_secs
    if args.pure == "click" and not args.item:
        ap.error("--pure click needs --item")
    if args.pure:
        return pure(args.pure, args.timeout_secs, args.item, args.wait_secs, args.then, args.then_after)
    loop = GLib.MainLoop()
    for sig in (signal.SIGTERM, signal.SIGINT):
        unix_signal_add(sig, lambda: (loop.quit(), False)[1])
    item = SniItem(loop, args.poll_secs)
    loop.run()
    return item.exit_code


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
