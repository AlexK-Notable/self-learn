#!/usr/bin/env python3
"""Regenerate ``src/self_learn/hook_rules_ctype.py``: the character classes
GNU grep uses under ``LC_ALL=C.UTF-8``, measured, for the rule evaluator.

A developer tool, run by hand on Linux with GNU grep (never by the suite,
never by the product). It writes every Unicode scalar value except NUL,
newline and the surrogates on its own line, asks ``grep -nE '^[[:class:]]$'``
which lines match, and encodes each class as base-36 range deltas. NUL and
newline cannot reach grep inside a hook (bash drops NUL bytes, grep splits on
newline), and are added to the classes glibc puts them in (``cntrl``; newline
also ``space``) so the bash empty-input test, which does see newlines, is
modelled exactly.

    plugins/self-learn/cli/scripts/gen-hook-rules-ctype [path/to/grep]
"""

from __future__ import annotations

import hashlib
import os
import platform
import re
import subprocess
import sys
from pathlib import Path

OUT = Path(__file__).resolve().parent.parent / "src" / "self_learn" / "hook_rules_ctype.py"
CLASSES = ("alpha", "upper", "lower", "print", "space", "blank", "cntrl")
B36 = "0123456789abcdefghijklmnopqrstuvwxyz"


def b36(n: int) -> str:
    s = ""
    while True:
        n, r = divmod(n, 36)
        s = B36[r] + s
        if not n:
            return s


def ranges(points: set[int]) -> list[list[int]]:
    out: list[list[int]] = []
    for c in sorted(points):
        if out and out[-1][1] == c - 1:
            out[-1][1] = c
        else:
            out.append([c, c])
    return out


def encode(points: set[int]) -> str:
    prev = -1
    parts = []
    for a, b in ranges(points):
        parts.append(b36(a - prev - 1) + "." + b36(b - a))
        prev = b
    return " ".join(parts)


#: Members each measured class must (True) and must not (False) hold, so a
#: grep that silently matched nothing, or everything, never gets written.
SANITY = {
    "alpha": {"a": True, "Z": True, "é": True, "1": False, "!": False},
    "upper": {"A": True, "É": True, "a": False},
    "lower": {"a": True, "é": True, "A": False},
    "print": {" ": True, "a": True, "\x01": False, "\x7f": False},
    "space": {" ": True, "\t": True, "\n": True, "a": False},
    "blank": {" ": True, "\t": True, "\x0b": False, "a": False},
    "cntrl": {"\x00": True, "\x01": True, "\x7f": True, "a": False},
}


def digest(encoded: dict[str, str]) -> str:
    """The tables' identity a rule artifact records (``match.ctype``):
    ``hook_rules`` refuses a rule built against other tables."""
    body = "\n".join(f"{n.upper()}={encoded[n]}" for n in CLASSES).encode("ascii")
    return "sha256:" + hashlib.sha256(body).hexdigest()


#: glibc's LC_CTYPE source, whose header names the Unicode version its
#: character classes were generated for ("It covers Unicode version 17.0.0").
I18N_CTYPE = Path("/usr/share/i18n/locales/i18n_ctype")


def glibc_unicode_version() -> str:
    try:
        text = I18N_CTYPE.read_text(encoding="utf-8", errors="replace")
    except OSError:
        return "unknown"
    m = re.search(r"covers Unicode version ([0-9]+(?:\.[0-9]+)*)", text)
    return m.group(1) if m else "unknown"


def fail(why: str) -> int:
    print(f"gen-hook-rules-ctype: {why}; nothing written", file=sys.stderr)
    return 2


def main() -> int:
    grep = sys.argv[1] if len(sys.argv) > 1 else "/usr/bin/grep"
    env = {"LC_ALL": "C.UTF-8", "PATH": "/usr/bin:/bin"}
    ver = subprocess.run([grep, "--version"], capture_output=True, text=True, env=env,
                         check=False)
    if ver.returncode != 0 or not ver.stdout:
        return fail(f"{grep} --version exited {ver.returncode}")
    version = ver.stdout.splitlines()[0]
    if "GNU grep" not in version:
        return fail(f"not GNU grep: {version}")
    cps = [c for c in range(1, 0x110000) if c != 10 and not 0xD800 <= c <= 0xDFFF]
    data = "".join(chr(c) + "\n" for c in cps).encode("utf-8")
    tables = {}
    for name in CLASSES:
        proc = subprocess.run([grep, "-nE", "--", f"^[[:{name}:]]$"], input=data,
                              capture_output=True, env=env, check=False)
        if proc.returncode != 0 or proc.stderr:
            return fail(f"grep [[:{name}:]] exited {proc.returncode} "
                        f"({proc.stderr.decode('utf-8', 'replace').strip()!r})")
        points = {cps[int(line.split(b":", 1)[0]) - 1]
                  for line in proc.stdout.split(b"\n") if line}
        tables[name] = points
    tables["cntrl"] |= {0, 10}
    tables["space"] |= {10}
    for name, members in SANITY.items():
        for ch, inside in members.items():
            if (ord(ch) in tables[name]) != inside:
                return fail(f"[[:{name}:]] {'lacks' if inside else 'holds'} U+{ord(ch):04X}")
    encoded = {name: encode(tables[name]) for name in CLASSES}
    libc = " ".join(platform.libc_ver())
    unicode_version = glibc_unicode_version()
    lines = [
        '"""GNU grep\'s character classes under ``LC_ALL=C.UTF-8``, for',
        ":mod:`self_learn.hook_rules`. GENERATED by",
        "``plugins/self-learn/cli/scripts/gen-hook-rules-ctype``; do not edit.",
        "",
        f"Measured with {version} on {libc}.",
        "Each table is a run of ``<gap>.<length>`` base-36 pairs: a range starts",
        "``gap`` code points after the previous range's end (the first after -1)",
        'and spans ``length`` further code points."""',
        "",
        f"SOURCE = {version + ' / ' + libc!r}",
        f"UNICODE = {unicode_version!r}",
        f"DIGEST = {digest(encoded)!r}",
        "",
    ]
    for name in CLASSES:
        lines.append(f"{name.upper()} = {encoded[name]!r}")
    # one write, after every measurement and check succeeded
    tmp = OUT.with_suffix(".py.tmp")
    tmp.write_text("\n".join(lines) + "\n", encoding="utf-8")
    os.replace(tmp, OUT)
    print(f"wrote {OUT.name}: " + ", ".join(f"{n} {len(ranges(tables[n]))}" for n in CLASSES))
    return 0


if __name__ == "__main__":
    os.umask(0o022)
    sys.exit(main())
