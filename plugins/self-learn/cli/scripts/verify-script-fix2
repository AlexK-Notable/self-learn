#!/usr/bin/env python3
"""R1-R4 mutation witnesses. Run once inside test-sweep; exact-byte restores."""
import hashlib
import json
from pathlib import Path
import subprocess
import sys
import xml.etree.ElementTree as ET

ROOT = Path(__file__).resolve().parents[1]
OUT = Path(sys.argv[1]).resolve()
OUT.mkdir(parents=True, exist_ok=True)
if not any('/' + name + '/' in Path('/proc/self/cgroup').read_text() for name in ('testing.slice', 'fulltest.slice')):
    raise SystemExit('run this entire serial driver through test-sweep --')
BASE = ['uv', 'run', '--no-sync', '--project', str(ROOT), 'python', '-B', '-m', 'pytest',
        'tests/test_script_fix_round2.py', '-q', '-p', 'no:cacheprovider']


def run(name):
    xml = OUT / (name + '.xml')
    with (OUT / (name + '.log')).open('w') as stream:
        result = subprocess.run(BASE + ['--junitxml=' + str(xml)], cwd=ROOT,
                                stdout=stream, stderr=subprocess.STDOUT)
    cases = list(ET.parse(xml).iter('testcase'))
    failures = [c.attrib['name'] for c in cases if c.find('failure') is not None]
    return result.returncode, cases, failures


rc, cases, _ = run('baseline')
assert rc == 0, 'baseline must pass before mutating'
expected = {c.attrib['name'] for c in cases}
MUTATIONS = [
    ('R1-trust-forged-record', 'script_proof.py',
     '    from .skill_scripts import _held, _safe, version',
     '    return None\n    from .skill_scripts import _held, _safe, version'),
    ('R1-skip-current-screen', 'skill_scripts.py',
     '    if not checked.ok:\n        raise ValueError("screen refused: " + "; ".join(checked.rules))',
     '    if False:\n        raise ValueError("screen refused: " + "; ".join(checked.rules))'),
    ('R1-ignore-native-contradiction', 'script_proof.py',
     'except (OSError, json.JSONDecodeError, KeyError, TypeError):',
     'except (OSError, ValueError, KeyError, TypeError):'),
    ('R2-pass-hazards', 'script_screen.py',
     'def screen(text: str) -> Screen:\n',
     'def screen(text: str) -> Screen:\n    return Screen("python", ())\n'),
    ('R2-refuse-controls', 'script_screen.py',
     'def screen(text: str) -> Screen:\n',
     'def screen(text: str) -> Screen:\n    return Screen("python", ("mutation: refuse",))\n'),
    ('R3-lose-history', 'skill_scripts.py',
     '    for commit in gitops._git_ok(home, "log", "--format=%H", "--", INDEX).stdout.splitlines():',
     '    return None\n    for commit in gitops._git_ok(home, "log", "--format=%H", "--", INDEX).stdout.splitlines():'),
    ('R3-strand-no-history', 'skill_scripts.py',
     '    if records is None:\n        records = []',
     '    if records is None:\n        return []\n        records = []'),
    ('R4-claim-foreign-file', 'skill_scripts.py',
     'def _managed_file(path: Path, row: dict, records: list[dict]) -> bool:\n',
     'def _managed_file(path: Path, row: dict, records: list[dict]) -> bool:\n    return True\n'),
]
results = []
for name, filename, before, after in MUTATIONS:
    path = ROOT / 'src/self_learn' / filename
    original = path.read_bytes()
    digest = hashlib.sha256(original).hexdigest()
    assert original.count(before.encode()) == 1, (name, 'ambiguous mutation')
    try:
        path.write_bytes(original.replace(before.encode(), after.encode()))
        rc, _, failed = run(name)
    finally:
        path.write_bytes(original)
        restored = hashlib.sha256(path.read_bytes()).hexdigest()
        assert restored == digest, name
    results.append(dict(name=name, file=filename, returncode=rc, failed=failed,
                        before=digest, after=restored))
    (OUT / 'mutation-results.json').write_text(json.dumps(results, indent=2) + '\n')
    print(name, 'rc=' + str(rc), 'failures=' + str(len(failed)), 'restored=' + str(restored == digest), flush=True)
    assert rc == 1 and failed, name
covered = {test for row in results for test in row['failed']}
assert expected <= covered, sorted(expected - covered)
rc, _, _ = run('restored')
assert rc == 0, 'restored code must pass'
print('coverage: ' + str(len(expected)) + '/' + str(len(expected)), flush=True)

from self_learn.script_screen import screen
probes = json.loads((ROOT / 'tests/data/script_screen_probes_round2.json').read_text())
results = [{'name': name, **screen(text).record()} for name, text in probes.items()]
(OUT / 'probe-results.json').write_text(json.dumps(results, indent=2) + '\n')
