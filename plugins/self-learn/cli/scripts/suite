#!/usr/bin/env bash
# self-learn CLI test suite — THE one way to run it (agents and humans).
#
#   plugins/self-learn/cli/scripts/suite            # full suite, 3 batches in parallel
#   SUITE_OUT=/some/dir plugins/self-learn/cli/scripts/suite   # keep the logs there
#
# What it encodes (each line is a past false-red or a lost cycle):
#   - strips SELF_LEARN_ANALYST_MODEL / SELF_LEARN_ANALYST_TIMEOUT from the env
#     (host exports distort 8 tests into false failures)
#   - one explicit `uv sync`, then `uv run --no-sync` so three parallel
#     runs never race the venv
#   - three batches (A/B/C) in parallel, `-p no:cacheprovider`; the --ignore
#     list for C is DERIVED from A and B so nothing is double-counted
#   - every batch's exit code is captured unpiped (redirect, never a pipe)
#   - exit 0 iff every batch exited 0; one summary line per batch
# Run it in the FOREGROUND from an agent: a backgrounded run dies with the turn.
set -u
ROOT=$(cd "$(dirname "$0")/../../../.." && pwd)
cd "$ROOT" || exit 2
PROJECT=plugins/self-learn/cli
T=$PROJECT/tests
A=("$T/test_invocation.py" "$T/test_invocation_sdk.py" "$T/test_u_sdka.py")
B=("$T/test_worker_contract.py" "$T/test_reader_contract.py" "$T/test_repair.py" "$T/test_attrib.py")
IGN=()
for f in "${A[@]}" "${B[@]}"; do IGN+=("--ignore=$f"); done
OUT=${SUITE_OUT:-$(mktemp -d -t self-learn-suite.XXXXXX)}
mkdir -p "$OUT"

uv sync --project "$PROJECT" -q || { echo "suite: uv sync failed"; exit 2; }

run_batch() {
  local name=$1; shift
  env -u SELF_LEARN_ANALYST_MODEL -u SELF_LEARN_ANALYST_TIMEOUT \
    uv run --no-sync --project "$PROJECT" pytest "$@" -p no:cacheprovider -q \
    > "$OUT/$name.log" 2>&1
  echo $? > "$OUT/$name.rc"
}

start=$(date +%s)
run_batch A "${A[@]}" &
run_batch B "${B[@]}" &
run_batch C "$T" "${IGN[@]}" &
wait
elapsed=$(( $(date +%s) - start ))

rc=0
for n in A B C; do
  r=$(cat "$OUT/$n.rc" 2>/dev/null || echo 99)
  summary=$(grep -E '^[0-9]+ (passed|failed|error)' "$OUT/$n.log" | tail -1)
  [ -n "$summary" ] || summary=$(tail -1 "$OUT/$n.log")
  printf 'suite %s rc=%s  %s\n' "$n" "$r" "$summary"
  [ "$r" = "0" ] || rc=1
done
printf 'suite total rc=%s  %ss  logs=%s\n' "$rc" "$elapsed" "$OUT"
exit $rc
