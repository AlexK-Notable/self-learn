#!/usr/bin/env bash
# self-learn landing runner — the twin of `scripts/suite`, and the last
# step of every unit: land a gated branch on master and push.
#
#   plugins/self-learn/cli/scripts/land \
#       --branch u-something \
#       --verdict 'blind Opus code gate CLEAN r3 with mutation verification' \
#       [--resolver <path>=<name> ...] [--sanitize-ack '<file>:<line>:<sha>=<reason>' ...] \
#       [--dry-run] [--continue]
#
# What it encodes (see docs/specs/self-learn/drafts/u-land-landing-runner-spec.md):
#   - set -uo pipefail, NOT -e: `-e` and explicit rc-capture are mutually
#     exclusive (measured, §4.10/EXC1/SUI5) -- every stage boundary is an
#     explicit `|| die <code>`, never relies on -e to abort.
#   - preconditions (main checkout, clean trees, reachable+fetched origin)
#     before anything is touched.
#   - `git merge-tree --write-tree` preview, then `git -c
#     merge.conflictStyle=diff3 merge --no-ff --no-commit` -- the runner
#     supplies diff3 on its OWN invocation, never trusting the operator's
#     dotfiles.
#   - named resolvers only (--resolver <path>=<name>); an unmapped
#     conflict refuses, printing the block list and the resolver names
#     that WOULD apply (a diagnostic, never a default).
#   - landing checks + the armor re-measure, INSIDE the merge commit --
#     never after it (incident 2's exact shape).
#   - the suites (CLI via scripts/suite; UI from inside plugins/self-learn/ui);
#     a docs-only landing runs a derived test set instead.
#   - a sanitize scan of the outgoing diff's ADDED lines only, with an
#     exact-coverage --sanitize-ack.
#   - push origin master, then a best-effort prune.
#   - every refusal exits its own §4.10 code and prints the one command
#     that inspects the state it left; codes 5-7 leave the merge commit
#     local and are resumable with --continue.
# Run it in the FOREGROUND: a backgrounded run dies with the turn
# (scripts/suite's own rule).
set -uo pipefail

# B-2 (gate r1). Every input this runner reads goes through one of these.
# An absent, empty or unresolvable input is FATAL -- never "nothing to
# check". Two instances of that shape shipped in this unit already
# (`allowlisted_only`'s empty failing set, and `doc_reading_set.txt`
# vanishing into a bare root pytest that exited 0 and PUSHED), so the
# reader is centralised rather than guarded line by line.
need_file() {
  local path=$1 what=$2 code=${3:-2}
  [ -e "$path" ] || die "$code" "$what: required input is ABSENT: $path" "ls -l $(dirname "$path")"
  [ -f "$path" ] || die "$code" "$what: required input is not a regular file: $path" "ls -l $path"
  [ -r "$path" ] || die "$code" "$what: required input is unreadable: $path" "ls -l $path"
}

# `usable_lines` is PURE -- it prints a count and never dies, so it is safe
# to call from `$( )`. `need_nonempty_file` dies and therefore returns
# NOTHING: a guard that both refuses and yields a value has to be called
# inside a command substitution, and `die` runs `exit`, which inside `$( )`
# ends only the SUBSHELL. That is the third instance of this shape in this
# unit (allowlisted_only's empty set, state_check's discarded rc, and this
# one); `test_exc1_no_die_is_reachable_from_a_command_substitution` now
# sweeps for it.
usable_lines() {
  grep -cve '^[[:space:]]*$' -e '^[[:space:]]*#' "$1" 2>/dev/null || true
}

need_nonempty_file() {
  local path=$1 what=$2 code=${3:-2}
  need_file "$path" "$what" "$code"
  local n
  n=$(usable_lines "$path")
  [ "$n" -ge 1 ] \
    || die "$code" "$what: required input has NO usable lines: $path" "cat $path"
}

# MAJOR-1 (gate r3). `git add` exits 0 when it stages NOTHING -- a pathspec
# that matched no change, a path already identical to HEAD. So an exit-code
# gate cannot tell "added" from "added nothing", and the two `git add`s in
# this script were ungated entirely. If the armor one silently added
# nothing, the merge commit would ship WITHOUT the new anchor while the
# working-tree suite still passed: incident 2's shape exactly.
#
# The gate is therefore a COUNT that reads differently if the add did not
# happen, not an exit code.
staged_add() {
  local gr=$1 rel=$2 what=$3 code=${4:-4}
  git -C "$gr" add -- "$rel" \
    || die "$code" "$what: git add failed for $rel" "git -C $gr status"
  local n
  n=$(git -C "$gr" diff --cached --name-only -- "$rel" | grep -c . || true)
  [ "$n" = "1" ] \
    || die "$code" "$what: git add exited 0 but staged $n change(s) for $rel -- an add that stages nothing is not an add" \
            "git -C $gr status --porcelain -- $rel"
  printf 'staged: %s (%s path)\n' "$rel" "$n"
}

# MAJOR-1 (gate r5). `--continue-merge` exists so a refusal LEAVES the
# merge for the operator to edit. A SECOND refusal must therefore not throw
# away the work the first one asked them to do -- measured before this
# guard: `EDIT SURVIVED: False`, with no message naming the loss, and
# unstaged edits surviving only by accident (git happens to refuse the
# abort when it would overwrite them). Staged ones did not survive at all.
#
# So every refusal inside the merge routes through here: it aborts on a
# FIRST pass, and on a resume it keeps the merge and says so.
abort_merge_unless_resuming() {
  local gr=$1
  if [ "$CONTINUE_MERGE" = "1" ]; then
    RESUME_KEPT=1
    # Say it. A refusal that silently preserved the work would be as hard
    # to act on as one that silently destroyed it.
    printf 'land: --continue-merge -- the merge and your in-merge edits are KEPT (%s changed path(s)); fix the refusal above and re-run with --continue-merge\n' \
      "$(git -C "$gr" status --porcelain | grep -c . || true)" >&2
    return 0
  fi
  git -C "$gr" update-index -q --refresh >>"$OUT/abort.log" 2>&1 || true
  git -C "$gr" merge --abort >>"$OUT/abort.log" 2>&1
  printf 'merge --abort rc=%s\n' "$?" >>"$OUT/abort.log"
}

# MINOR-1/NIT-4: BOTH halves derived, never asserted. Deriving the first
# half is what exposed the swallowed `merge --abort` rc and the
# `os.replace` stat-cache trap, so the second half gets the same treatment
# rather than a claim about a tree nobody looked at.
tree_state_sentence() {
  local gr=$1 merging="no" dirty
  git -C "$gr" rev-parse -q --verify MERGE_HEAD >/dev/null 2>&1 && merging="yes"
  dirty=$(git -C "$gr" status --porcelain | grep -c . || true)
  if [ "$merging" = "yes" ]; then
    printf 'The merge is LEFT UNCOMMITTED (%s changed path(s) in the tree)' "$dirty"
  elif [ "$dirty" = "0" ]; then
    printf 'The merge was ABORTED and the tree restored (0 changed paths, measured)'
  else
    printf 'The merge was ABORTED but the tree is NOT clean (%s changed path(s) remain -- inspect before re-running)' "$dirty"
  fi
}

need_dir() {
  local path=$1 what=$2 code=${3:-2}
  [ -d "$path" ] || die "$code" "$what: required directory is ABSENT: $path" "ls -l $(dirname "$path")"
}

die() {
  local code=$1 msg=$2 inspect=${3:-}
  printf 'land: %s\n' "$msg" >&2
  if [ -n "$inspect" ]; then
    printf '  inspect: %s\n' "$inspect" >&2
  fi
  exit "$code"
}

# root resolution FIRST (§4.1: one rule for the whole package) -- before
# argument parsing, so --help can list the registry dynamically rather
# than a hand-copied string RES4 could drift from.
ROOT=$(git rev-parse --path-format=absolute --show-toplevel 2>/dev/null) \
  || die 2 "not inside a git repository"
cd "$ROOT" || die 2 "cannot cd to repo root: $ROOT"

# PROJECT is where THIS SCRIPT lives (its own venv/installed code), which
# is deliberately independent of --root/$ROOT: every landing module takes
# --root explicitly and never infers it (§4.1's one rule), so the CODE
# that runs it may safely be the shipped build's own venv even when
# operating on a throwaway fixture or a --dry-run worktree as data. The
# one documented exception is CHK5, which shells out to THAT tree's own
# copy of test_personal_literals.py by path (gate M-10) rather than
# through this venv, because that test resolves its root from its own
# on-disk location.
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
PROJECT="$(cd "$SCRIPT_DIR/.." && pwd)"
LANDING_SRC="$PROJECT/src"
RESOLVER_NAMES=$(PYTHONPATH="$LANDING_SRC" python3 -c \
  "from self_learn.landing import resolvers as R; print(' '.join(sorted(R.REGISTRY)))") \
  || die 2 "cannot import the resolver registry from $LANDING_SRC" "ls -l $LANDING_SRC/self_learn/landing"
[ -n "$RESOLVER_NAMES" ] \
  || die 2 "the resolver registry resolved EMPTY -- --resolver could name nothing"

print_help() {
  cat <<EOF
usage: land --branch <name> --verdict '<text>' [options]

  --branch <name>            the branch to land onto master (required)
  --verdict '<text>'         the gate verdict line, verbatim in the merge
                              commit subject (required unless --continue)
  --resolver <path>=<name>   map a conflicted path to a named resolver;
                              repeatable. registry: $RESOLVER_NAMES
  --sanitize-ack '<file>:<line>:<sha256>=<reason>'
                              acknowledge one sanitize hit; repeatable
  --dry-run                  simulate the whole landing in a throwaway
                              worktree; nothing on master is touched or pushed
  --continue                 resume a landing that refused after the merge
                              commit (exit 5/6/7), never re-merging
  --continue-merge           resume a landing that refused BEFORE the merge
                              commit, with the merge still in the tree and
                              the owed armor edits made in place; re-runs
                              the checks without re-merging
  --help                     this text
EOF
}

# ---------------------------------------------------------------------------
# argument parsing

BRANCH=""
VERDICT=""
DRY_RUN=0
CONTINUE_FLAG=0
# The PRE-COMMIT sibling of --continue. `--remeasure`'s three pre-write
# refusals leave the merge UNCOMMITTED on purpose, because the runbook's
# §5.1 loop is to make the owed edits inside that merge and re-run -- so
# the transcription rides in the merge commit beside the anchor advance,
# never committed on its own (between the two the armor suite is briefly
# red, which is inherent to check-then-write). Without this flag PRE3
# refuses the re-run as a dirty tree, and the refusal that told the
# operator to re-run would be its own second false claim.
CONTINUE_MERGE=0
#: set when a refusal KEPT the merge because we were resuming (MAJOR-1)
RESUME_KEPT=0
declare -A RESOLVER_MAP=()
SANITIZE_ACK_ARGS=()

while [ $# -gt 0 ]; do
  case "$1" in
    --branch)
      [ $# -ge 2 ] || die 2 "--branch requires a value"
      BRANCH=$2; shift 2 ;;
    --verdict)
      [ $# -ge 2 ] || die 2 "--verdict requires a value"
      VERDICT=$2; shift 2 ;;
    --resolver)
      [ $# -ge 2 ] || die 2 "--resolver requires a value"
      spec=$2
      case "$spec" in
        *=*) rpath=${spec%%=*}; rname=${spec#*=} ;;
        *) die 2 "--resolver value must be <path>=<name>: $spec" ;;
      esac
      RESOLVER_MAP["$rpath"]=$rname
      shift 2 ;;
    --sanitize-ack)
      [ $# -ge 2 ] || die 2 "--sanitize-ack requires a value"
      SANITIZE_ACK_ARGS+=("$2")
      shift 2 ;;
    --dry-run) DRY_RUN=1; shift ;;
    --continue) CONTINUE_FLAG=1; shift ;;
    --continue-merge) CONTINUE_MERGE=1; shift ;;
    --help|-h) print_help; exit 0 ;;
    *) die 2 "unknown argument: $1" ;;
  esac
done

[ -n "$BRANCH" ] || die 2 "--branch is required"
# NIT-5: --continue-merge resumes a merge in the MAIN checkout; --dry-run
# builds a throwaway worktree that has no such merge, so the combination
# would refuse with a message about the wrong tree. Refuse it by name.
if [ "$DRY_RUN" = "1" ] && [ "$CONTINUE_MERGE" = "1" ]; then
  die 2 "--dry-run and --continue-merge are mutually exclusive: --continue-merge resumes the merge in the MAIN checkout, and --dry-run never creates one there"
fi
if [ "$CONTINUE_FLAG" = "0" ]; then
  [ -n "$VERDICT" ] || die 2 "--verdict is required (unless --continue)"
fi

OUT=$(mktemp -d -t self-learn-land.XXXXXX)

uv sync --project "$PROJECT" -q || die 2 "uv sync (this build's own CLI project) failed"

py_landing() {
  # $1 = submodule name, rest = its args
  local mod=$1; shift
  ( cd "$PROJECT" && uv run --no-sync python3 -m "self_learn.landing.$mod" "$@" )
}

# ---------------------------------------------------------------------------
# --continue / CNT1

# CNT1's guard. Its rc used to be DISCARDED (gate r2 MAJOR-5): if the module
# failed, CHECK_OUT came back empty, IN_STATE came back empty, and the
# `[ "$IN_STATE" = "yes" ]` test simply did not fire -- the guard silently
# not running looked exactly like the guard passing.
state_check() {
  py_landing state --root "$ROOT" --branch "$BRANCH" check 2>"$OUT/state.err"
}

# NOTE, measured the hard way: this must NOT be called inside `$(...)`.
# `die` runs `exit`, and inside a command substitution that exits only the
# SUBSHELL -- the refusal prints, the script carries on, and the guard not
# firing looks exactly like the guard passing. The first version of this
# fix had that shape and reached CHK1 after announcing a fatal CNT1
# refusal. So it takes the value it needs to check as an ARGUMENT and
# returns nothing.
require_state_answer() {
  local rc=$1 value=$2 key=$3
  # `state ... check` answers with rc 0 (resumable) or rc 1 (not) -- BOTH
  # are real answers and both print the key. Any other rc is the module
  # failing to run, and an ABSENT key is the only reliable signal of that,
  # since a crash prints nothing at all.
  case "$rc" in
    0|1) ;;
    *) die 2 "CNT1: the landing-state check exited $rc, which is not one of its two answers (0 resumable / 1 not) -- its guard cannot be relied on" "cat $OUT/state.err" ;;
  esac
  [ -n "$value" ] \
    || die 2 "CNT1: the landing-state check produced no '$key' line (rc=$rc) -- refusing rather than reading its silence as 'no'" "cat $OUT/state.err"
}

if [ "$CONTINUE_FLAG" = "1" ]; then
  CHECK_OUT=$(state_check)
  STATE_RC=$?
  IN_STATE=$(printf '%s\n' "$CHECK_OUT" | sed -n 's/^in_post_commit_refusal_state=//p')
  require_state_answer "$STATE_RC" "$IN_STATE" in_post_commit_refusal_state
  OK=$(printf '%s\n' "$CHECK_OUT" | sed -n 's/^ok=//p')
  RESUME_STEP=$(printf '%s\n' "$CHECK_OUT" | sed -n 's/^resume_step=//p')
  REASON=$(printf '%s\n' "$CHECK_OUT" | sed -n 's/^reason=//p')
  [ "$OK" = "yes" ] || die 2 "--continue impossible: $REASON" "python3 -m self_learn.landing.state --root $ROOT --branch $BRANCH read"
else
  CHECK_OUT=$(state_check)
  STATE_RC=$?
  IN_STATE=$(printf '%s\n' "$CHECK_OUT" | sed -n 's/^in_post_commit_refusal_state=//p')
  require_state_answer "$STATE_RC" "$IN_STATE" in_post_commit_refusal_state
  if [ "$IN_STATE" = "yes" ]; then
    die 2 "CNT1: '$BRANCH' has a merge commit from a refused landing not yet on origin/master; re-run with --continue" \
      "python3 -m self_learn.landing.state --root $ROOT --branch $BRANCH read"
  fi
fi

# ---------------------------------------------------------------------------
# Step 1 — preconditions (PRE1-PRE8), skipped when resuming via --continue
# (HEAD is deliberately not master while a merge commit is pending resume).

if [ "$CONTINUE_FLAG" = "0" ]; then
  GITDIR=$(git rev-parse --path-format=absolute --git-dir)
  COMMONDIR=$(git rev-parse --path-format=absolute --git-common-dir)
  [ "$GITDIR" = "$COMMONDIR" ] \
    || die 2 "PRE1: not run from the main checkout (git-dir=$GITDIR common-dir=$COMMONDIR)" "git worktree list"

  HEAD_REF=$(git symbolic-ref --short HEAD 2>/dev/null) || die 2 "PRE2: HEAD is detached" "git status"
  [ "$HEAD_REF" = "master" ] || die 2 "PRE2: HEAD is '$HEAD_REF', not master" "git status"

  DIRTY_MASTER=$(git status --porcelain | wc -l | tr -d ' ')
  if [ "$CONTINUE_MERGE" = "1" ]; then
    # MINOR-2, stated to match what is ENFORCED. This verifies the merge's
    # IDENTITY -- that one is in progress, and that it is THIS branch's tip
    # -- and nothing about the provenance of the individual dirty paths. It
    # deliberately cannot: the point of the flag is that the operator has
    # edited the tree by hand, so "which dirt is legitimate" is not
    # decidable here. What it does buy is that the flag cannot be pointed
    # at a tree with no merge, or at a merge of something else.
    # NIT-1: asked of git rather than by probing $ROOT/.git, which is a
    # FILE, not a directory, in a linked worktree.
    git -C "$ROOT" rev-parse -q --verify MERGE_HEAD >/dev/null 2>&1 \
      || die 2 "PRE3/--continue-merge: there is no merge in progress to resume" "git status"
    MERGING=$(git rev-parse MERGE_HEAD)
    BRANCH_TIP=$(git rev-parse "refs/heads/$BRANCH")
    [ "$MERGING" = "$BRANCH_TIP" ] \
      || die 2 "PRE3/--continue-merge: the merge in progress is $MERGING, not '$BRANCH' ($BRANCH_TIP)" "git status"
    echo "land: resuming the in-progress merge of $BRANCH ($DIRTY_MASTER dirty path(s))"
  else
    [ "$DIRTY_MASTER" = "0" ] || die 2 "PRE3: master's tree is dirty ($DIRTY_MASTER lines)" "git status"
  fi

  BRANCH_WT=""
  cur_wt=""
  while IFS= read -r line; do
    case "$line" in
      worktree\ *) cur_wt=${line#worktree } ;;
      "branch refs/heads/$BRANCH") BRANCH_WT=$cur_wt ;;
    esac
  done < <(git worktree list --porcelain)
  if [ -n "$BRANCH_WT" ]; then
    WT_DIRTY=$(git -C "$BRANCH_WT" status --porcelain | wc -l | tr -d ' ')
    [ "$WT_DIRTY" = "0" ] \
      || die 2 "PRE4: branch worktree $BRANCH_WT is dirty ($WT_DIRTY lines)" "git -C $BRANCH_WT status"
  fi

  [ "$BRANCH" != "master" ] || die 2 "PRE5: branch cannot be master"
  git rev-parse --verify -q "refs/heads/$BRANCH" >/dev/null 2>&1 \
    || die 2 "PRE5: branch '$BRANCH' does not exist"
  git merge-base master "$BRANCH" >/dev/null 2>&1 \
    || die 2 "PRE5: '$BRANCH' shares no history with master"

  git ls-remote --exit-code origin HEAD >/dev/null 2>&1
  RC_REMOTE=$?
  [ "$RC_REMOTE" = "0" ] || die 2 "PRE6: origin is unreachable (rc=$RC_REMOTE)"

  BASE_BEFORE=$(git rev-parse origin/master 2>/dev/null || echo "")
  git fetch origin master >"$OUT/fetch.log" 2>&1
  RC_FETCH=$?
  [ "$RC_FETCH" = "0" ] || die 2 "PRE8: git fetch origin master failed (rc=$RC_FETCH)" "cat $OUT/fetch.log"
  BASE_AFTER=$(git rev-parse origin/master)
  if [ -n "$BASE_BEFORE" ] && [ "$BASE_BEFORE" != "$BASE_AFTER" ]; then
    die 2 "PRE8: origin/master moved during fetch ($BASE_BEFORE -> $BASE_AFTER); re-run against the new base"
  fi
  BASE_SHA=$BASE_AFTER
else
  # resuming: the sanitize range must stay anchored to the SAME base the
  # original run computed it against (PRE8's freshness guarantee was for
  # that run; a --continue does not re-fetch or re-scope).
  BASE_SHA=$(py_landing state --root "$ROOT" --branch "$BRANCH" read 2>/dev/null \
    | python3 -c "import json,sys; print(json.load(sys.stdin).get('base_sha',''))")
  [ -n "$BASE_SHA" ] || die 2 "--continue: state file has no recorded base_sha"
fi

# ---------------------------------------------------------------------------
# GITROOT: the tree every subsequent git/module operation acts on --
# $ROOT for a real landing, a throwaway detached worktree for --dry-run.

TMP=""
cleanup_tmp() {
  # PSH3: this script has no forcing capability anywhere, in any form --
  # an ordinary worktree remove, then rm+prune as the fallback if the
  # throwaway tree isn't itself clean enough for that.
  if [ -n "$TMP" ] && [ -d "$TMP" ]; then
    git -C "$ROOT" worktree remove "$TMP" >/dev/null 2>&1 \
      || { rm -rf "$TMP"; git -C "$ROOT" worktree prune >/dev/null 2>&1 || true; }
  fi
}
trap cleanup_tmp EXIT

if [ "$DRY_RUN" = "1" ]; then
  TMP=$(mktemp -d -t self-learn-land-dry.XXXXXX)
  rmdir "$TMP"
  git -C "$ROOT" worktree add --detach "$TMP" master >"$OUT/dryrun-worktree.log" 2>&1 \
    || die 3 "--dry-run: could not create throwaway worktree" "cat $OUT/dryrun-worktree.log"
  GITROOT="$TMP"
else
  GITROOT="$ROOT"
fi

if [ "$CONTINUE_FLAG" = "1" ]; then
  # Resuming: GITROOT is $ROOT and HEAD is already the merge commit.
  RESUME_ONLY=1
else
  RESUME_ONLY=0
fi

# ---------------------------------------------------------------------------
# Step 2 — preview (PRV1-PRV4)

run_merge_and_checks() {
  local gr=$1

  if [ "$CONTINUE_MERGE" = "1" ]; then
    # The merge is already in the tree and its conflicts (if any) were
    # resolved on the first pass. Re-merging would discard the operator's
    # in-merge edits, which are the whole point of the resume.
    echo "land: --continue-merge -- skipping preview and merge, re-running the checks"
    LANE_CLEAN=1
  else
  local preview_rc
  git -C "$gr" merge-tree --write-tree master "$BRANCH" >"$OUT/preview.txt" 2>&1
  preview_rc=$?
  case "$preview_rc" in
    0) LANE_CLEAN=1 ;;
    1) LANE_CLEAN=0 ;;
    *) die 3 "merge-tree failed rc=$preview_rc" "cat $OUT/preview.txt" ;;
  esac

  if [ "$LANE_CLEAN" = "1" ] && [ "${#RESOLVER_MAP[@]}" -gt 0 ]; then
    die 3 "PRV1: --resolver given but the preview is clean (no conflict) -- the operator's model of this merge is wrong"
  fi

  # Step 2b/3 — the merge itself, with diff3 supplied on OUR invocation (PRV3/F-1).
  # Runs BEFORE the unmapped-path check: PRV2's suggestion surface reads
  # REAL diff3-marked conflict blocks off disk, which only exist after
  # this merge actually runs (a merge-tree --name-only preview lists
  # PATHS, never block content).
  git -C "$gr" -c merge.conflictStyle=diff3 merge --no-ff --no-commit "$BRANCH" \
    >"$OUT/merge.txt" 2>&1
  local merge_rc=$?
  if [ "$merge_rc" != "0" ] && [ "$LANE_CLEAN" = "1" ]; then
    die 3 "merge failed unexpectedly on a clean preview (rc=$merge_rc)" "cat $OUT/merge.txt"
  fi

  if [ "$LANE_CLEAN" = "0" ]; then
    local conflicted
    # --name-only's output is: <tree-oid>\n<path>\n...<path>\n\n<messages...>
    # -- paths run from line 2 up to (not including) the first blank line;
    # everything after that blank line is "Auto-merging"/"CONFLICT (...)"
    # prose, never a path.
    conflicted=$(git -C "$gr" merge-tree --write-tree --name-only master "$BRANCH" 2>/dev/null \
      | tail -n +2 | sed '/^$/q' | sed '$ { /^$/d }')
    local unmapped=()
    local path
    while IFS= read -r path; do
      [ -n "$path" ] || continue
      if [ -z "${RESOLVER_MAP[$path]:-}" ]; then
        unmapped+=("$path")
      fi
    done <<<"$conflicted"
    if [ "${#unmapped[@]}" -gt 0 ]; then
      {
        echo "PRV2: the following conflicted paths have no --resolver mapping:"
        for path in "${unmapped[@]}"; do
          local suggestion
          suggestion=$(py_landing resolve --root "$gr" --path "$path" --suggest 2>/dev/null)
          echo "  $path  (candidates: ${suggestion:-none})"
        done
      } >"$OUT/prv2.txt"
      cat "$OUT/prv2.txt" >&2
      abort_merge_unless_resuming "$gr"
      die 3 "PRV2: unmapped conflicted path(s), see above" "cat $OUT/prv2.txt"
    fi

    local name
    for path in "${!RESOLVER_MAP[@]}"; do
      name=${RESOLVER_MAP[$path]}
      [ -f "$gr/$path" ] || die 3 "PRV2: --resolver names a path not in the conflict: $path"
      if ! grep -q '^||||||| ' "$gr/$path"; then
        abort_merge_unless_resuming "$gr"
        die 3 "PRV3: $path has no ||||||| base marker -- refusing to parse a conflict without its base" "cat $gr/$path"
      fi
      py_landing resolve --root "$gr" --path "$path" --resolver "$name" --branch "$BRANCH" \
        >>"$OUT/resolvers.log" 2>&1
      local resolve_rc=$?
      if [ "$resolve_rc" != "0" ]; then
        abort_merge_unless_resuming "$gr"
        die 3 "resolver '$name' refused on $path" "cat $OUT/resolvers.log"
      fi
      staged_add "$gr" "$path" "resolver '$name'" 3
    done
  fi

  fi

  # CHK1 -- conflict markers over the merge-touched set (not a hardcoded list)
  local touched
  touched=$(git -C "$gr" diff --name-only HEAD | sort -u) \
    || die 4 "CHK1: could not enumerate the merge-touched set"
  local abspaths=()
  local t
  while IFS= read -r t; do
    [ -n "$t" ] || continue
    abspaths+=("$gr/$t")
  done <<<"$touched"
  # B-2 floor: a --no-ff merge ALWAYS touches something. An empty set means
  # the enumeration failed, and scanning zero files for conflict markers
  # would print "no conflict markers" -- the exact shape this unit exists
  # to end.
  [ "${#abspaths[@]}" -ge 1 ] \
    || { abort_merge_unless_resuming "$gr"
         die 4 "CHK1: the merge-touched set is EMPTY -- refusing to report clean over zero files" "git -C $gr status"; }
  if ! py_landing checks --root "$gr" markers "${abspaths[@]}" >"$OUT/chk1.log" 2>&1; then
    abort_merge_unless_resuming "$gr"
    die 4 "CHK1: conflict markers remain in the merge-touched set" "cat $OUT/chk1.log"
  fi

  # CHK3 -- duplicates always refuse; row DISORDER refuses only when this
  # merge introduced it. The baseline is HEAD, which mid-merge is still
  # master's pre-merge tip. Measured 2026-08-29: master's own
  # 14-forward-work-map.md carries 9 descending adjacent pairs inside ONE
  # contiguous table, so the strict whole-file form refuses every landing.
  if ! py_landing checks --root "$gr" roworder --base HEAD >"$OUT/chk3.log" 2>&1; then
    abort_merge_unless_resuming "$gr"
    die 4 "CHK3: S-/FW- row order violation" "cat $OUT/chk3.log"
  fi

  # CHK4 -- landing-state prose
  if ! py_landing checks --root "$gr" prose >"$OUT/chk4.log" 2>&1; then
    abort_merge_unless_resuming "$gr"
    die 4 "CHK4: landing-state prose found" "cat $OUT/chk4.log"
  fi

  # CHK5 -- personal-literals gate, via U-scrub's SHIPPED test (never a private copy),
  # against THIS tree's own copy of the test (root-relative -- gate M-10).
  # B-2: absence is FATAL, not a skip. The old `if [ -f ... ]` guard meant a
  # tree that had LOST the personal-literals gate landed with the gate
  # silently not run -- on a PUBLIC repository.
  local literals_test="$gr/plugins/self-learn/cli/tests/test_personal_literals.py"
  if [ ! -f "$literals_test" ]; then
    abort_merge_unless_resuming "$gr"
    die 4 "CHK5: the personal-literals gate is ABSENT from the tree being landed ($literals_test) -- refusing to land unscanned" "ls -l $gr/plugins/self-learn/cli/tests/"
  fi
  # PYTHONDONTWRITEBYTECODE: CHK5 must not leave `__pycache__` in the tree
  # it is judging. Measured -- it did, and `git status --porcelain` on the
  # landed tree came back dirty afterwards. It also removes one more way for
  # this runner to author bytecode that a later step could read as stale.
  if ! ( cd "$PROJECT" && PYTHONDONTWRITEBYTECODE=1 \
         uv run --no-sync pytest "$literals_test" -q -p no:cacheprovider ) \
      >"$OUT/chk5.log" 2>&1; then
    abort_merge_unless_resuming "$gr"
    die 4 "CHK5: personal-literals gate failed" "cat $OUT/chk5.log"
  fi

  # CHK6 -- verdict shape (only meaningful on a fresh landing; --continue reuses the recorded verdict)
  if [ "$RESUME_ONLY" = "0" ]; then
    if ! py_landing checks --root "$gr" verdict --verdict "$VERDICT" >"$OUT/chk6.log" 2>&1; then
      abort_merge_unless_resuming "$gr"
      die 4 "CHK6: --verdict rejected" "cat $OUT/chk6.log"
    fi
  fi

  # world detection -- POST-merge, on the staged tree (M-6). Runs LAST,
  # immediately before `git commit`: CHK8 requires NOTHING test-shaped
  # between the armor check/remeasure below and the commit, so every
  # other check (including CHK5's pytest shell-out) must already be done.
  local world
  world=$(py_landing checks --root "$gr" world 2>"$OUT/world.err")
  local world_rc=$?
  if [ "$world_rc" != "0" ]; then
    abort_merge_unless_resuming "$gr"
    die 4 "world detection: $(cat "$OUT/world.err")" "cat $OUT/world.err"
  fi

  # CHK2 / armor, per the detected world -- the LAST check before commit.
  if [ "$world" = "armor_shas" ]; then
    if ! py_landing checks --root "$gr" pins >"$OUT/chk2.log" 2>&1; then
      abort_merge_unless_resuming "$gr"
      die 4 "CHK2: armor pin check failed" "cat $OUT/chk2.log"
    fi
  else
    local armor_test="$gr/plugins/self-learn/cli/tests/test_armor.py"
    need_file "$armor_test" "WLD2 (armor re-measure)" 4
    local anchor
    anchor=$(git -C "$gr" rev-parse --short=7 HEAD)

    # The four-leg refusal contract, per 15-orchestration-runbook.md 5.1 --
    # implemented against that prose, which exists so a runner need not read
    # test_armor.py. Its terms, and what each one costs to get wrong:
    #   * stdout is ALWAYS empty, success and refusal alike; every
    #     diagnostic is on stderr. So the two streams are captured
    #     SEPARATELY -- merging them would throw away the one invariant
    #     that distinguishes "said nothing" from "said it on the wrong
    #     stream".
    #   * rc 0 = success (stderr is exactly `ANCHOR <old7> -> <new7>`).
    #   * rc 1 carrying a START-OF-LINE token is a modelled refusal:
    #     `OWED: `, `VACUOUS: `, `STALE: ` (pre-write, file byte-unchanged,
    #     and they can appear TOGETHER in one run) or
    #     `ANCHOR did not change (` (post-write, byte-identical).
    #   * anything else -- rc 2 from argparse, a raised git failure, or an
    #     rc 1 with none of the tokens -- is UNMODELLED. Do not proceed.
    # The tokens are matched anchored (`^TOKEN`), as the contract states;
    # the trailer is deliberately written to contain no bare token, so an
    # unanchored match would also work today, but the anchored form is what
    # is promised.
    local armor_sha_before
    armor_sha_before=$(sha256sum "$armor_test" | cut -d" " -f1)
    ( cd "$PROJECT" && uv run --no-sync python3 "$armor_test" --remeasure --anchor "$anchor" ) \
      >"$OUT/remeasure.out" 2>"$OUT/remeasure.err"
    local remeasure_rc=$?
    local armor_sha_after
    armor_sha_after=$(sha256sum "$armor_test" | cut -d" " -f1)
    cat "$OUT/remeasure.out" "$OUT/remeasure.err" >"$OUT/remeasure.log"

    local owed vacuous stale noop stdout_bytes
    owed=$(grep -c "^OWED: " "$OUT/remeasure.err" || true)
    vacuous=$(grep -c "^VACUOUS: " "$OUT/remeasure.err" || true)
    # `STALE:` is a THREE-line RECORD (the row, its shipped value, its
    # value at the new anchor), so counting lines would report 3 where an
    # operator has 1 row to transcribe. Count the record's first line.
    stale=$(grep -cE "^STALE: .*MEASURED\[" "$OUT/remeasure.err" || true)
    noop=$(grep -c "^ANCHOR did not change (" "$OUT/remeasure.err" || true)
    stdout_bytes=$(wc -c <"$OUT/remeasure.out" | tr -d " ")

    if [ "$remeasure_rc" != "0" ]; then
      # The contract promises the file is byte-unchanged on the three
      # pre-write legs and byte-identical on the no-op. Verify rather than
      # trust: a refusal that MOVED the file is not a state this runner
      # knows how to leave behind.
      local intact="yes"
      [ "$armor_sha_before" = "$armor_sha_after" ] || intact="NO"

      if [ "$remeasure_rc" = "1" ] && [ $((owed + vacuous + stale)) -gt 0 ]; then
        # The MERGE IS LEFT IN PLACE, deliberately, and that is why this
        # message can say so. The runbook's §5.1 loop is: write the owed
        # exemption entry, drop the vacuous one, copy each printed
        # `value at <anchor>:` into that MEASURED row, then re-run the same
        # command -- all of it INSIDE the still-uncommitted merge, so the
        # transcription rides in the merge commit beside the anchor
        # advance. Aborting here would destroy the state the operator is
        # being told to edit; this refusal used to abort eight lines above
        # and then describe a merge that no longer existed (gate r4
        # MAJ-1). On the bootstrap it fires with certainty, so it is the
        # first thing the operator reads.
        die 4 "WLD2: --remeasure refused BEFORE writing -- $owed OWED, $vacuous VACUOUS, $stale STALE record(s); file intact: $intact. $(tree_state_sentence "$gr") on purpose: make those edits here, then re-run this same command with --continue-merge, and the transcription rides inside the merge commit. To walk away instead: git -C $gr add -A && git -C $gr merge --abort -- a BARE abort refuses while your edits are unstaged (measured: rc 128, merge still in progress)" \
              "cat $OUT/remeasure.err"
      fi

      # The remaining legs give the operator nothing to edit in place, so
      # the tree IS restored -- and each message says which of the two
      # states it left behind.
      # The no-op leg REWRITES the file before refusing, so the working
      # tree carries a local modification and a bare `merge --abort` can
      # refuse to overwrite it. Restore that one file first -- by asking
      # git for the merge's own version of it, never a blanket reset --
      # then abort, then SAY WHAT IS TRUE.
      # `--remeasure`'s no-op leg rewrites the file via `os.replace()`, so
      # its mtime moves even when the bytes do not, and git's stat cache
      # goes stale. `merge --abort` then refuses outright -- measured:
      # "error: Entry '...test_armor.py' not uptodate. Cannot merge." at
      # rc 128, after which the old code claimed a restored tree over a
      # merge that was still there. Refreshing the index is the narrow
      # remedy; it touches no content and is not a reset.
      abort_merge_unless_resuming "$gr"
      if [ "$remeasure_rc" = "1" ] && [ "$noop" -gt 0 ]; then
        die 4 "WLD2: --remeasure had nothing to advance (the no-op guard); file intact: $intact. $(tree_state_sentence "$gr") -- there is nothing to edit here" \
              "cat $OUT/remeasure.err"
      fi
      die 4 "WLD2: --remeasure failed UNMODELLED (rc=$remeasure_rc, no OWED/VACUOUS/STALE/no-op token on stderr, stdout $stdout_bytes bytes) -- refusing rather than guessing what it did. $(tree_state_sentence "$gr")" \
            "cat $OUT/remeasure.err"
    fi

    # Success. The contract says stdout is empty and stderr is exactly the
    # one advance line; both are asserted, because a success that talked on
    # the wrong stream is a contract change this runner must not ride over.
    [ "$stdout_bytes" = "0" ] \
      || die 4 "WLD2: --remeasure succeeded but wrote $stdout_bytes byte(s) to STDOUT; the contract says stdout is always empty" "cat $OUT/remeasure.out"
    grep -qE "^ANCHOR [0-9a-f]{7} -> $anchor\$" "$OUT/remeasure.err" \
      || die 4 "WLD2: --remeasure exited 0 but stderr is not the expected 'ANCHOR <old> -> $anchor' line" "cat $OUT/remeasure.err"
    [ "$armor_sha_before" != "$armor_sha_after" ] \
      || die 4 "WLD2: --remeasure exited 0 but left test_armor.py byte-identical -- the anchor did not actually advance" "cat $OUT/remeasure.err"

    staged_add "$gr" plugins/self-learn/cli/tests/test_armor.py "WLD2 (armor re-measure)" 4
    # The rewritten module must be the one the POST-COMMIT suite imports.
    # Measured 2026-08-29: `--remeasure` swaps one 7-char anchor literal
    # for another, so the file's SIZE does not change; CPython invalidates
    # cached bytecode on (source mtime, source size), both at 1-second
    # granularity, so a .pyc written in the same second as the rewrite is
    # still considered valid. Reproduced end to end in a fixture -- the
    # suite read ANCHOR "0000000" out of a stale .pyc while the file on
    # disk said "69d6b72", and the landing refused at exit 5 on a FALSE
    # ARM5 red. Dropping the cached bytecode is the narrowest fix
    # available from here: test_armor.py is itself a protected file this
    # unit may not edit.
    rm -f "$gr"/plugins/self-learn/cli/tests/__pycache__/test_armor.*.pyc
    local stale_pyc
    stale_pyc=$(find "$gr/plugins/self-learn/cli/tests/__pycache__" \
      -maxdepth 1 -name 'test_armor.*.pyc' 2>/dev/null | wc -l | tr -d ' ')
    [ "$stale_pyc" = "0" ] \
      || die 4 "WLD2: cached test_armor bytecode survived removal ($stale_pyc file(s)); the suite would import a stale ANCHOR" \
              "ls $gr/plugins/self-learn/cli/tests/__pycache__/"
  fi
  # CHK8: nothing test-shaped runs between the line above and `git commit`.
}

if [ "$RESUME_ONLY" = "0" ]; then
  run_merge_and_checks "$GITROOT"

  # ---------------------------------------------------------------------
  # commit -- everything above rides INSIDE this commit
  UNIT_GUESS=${BRANCH#u-}
  SUBJECT="Merge branch '$BRANCH' ($UNIT_GUESS — $VERDICT)"
  git -C "$GITROOT" commit -q -m "$SUBJECT" || die 4 "git commit failed"
  MERGE_SHA=$(git -C "$GITROOT" rev-parse HEAD)
  MERGE_PARENTS=$(git -C "$GITROOT" log -1 --format=%P HEAD)

  if [ "$DRY_RUN" = "0" ]; then
    # EXC1: this write is what `--continue` resumes from. A silent failure
    # here leaves a merge commit that exists but cannot be resumed, so it
    # gets its own `|| die` like every other stage boundary.
    py_landing state --root "$ROOT" --branch "$BRANCH" write \
      --json "$(python3 -c "import json,sys; print(json.dumps({'base_sha': sys.argv[1], 'merge_sha': sys.argv[2], 'parent_shas': sys.argv[3].split(), 'verdict': sys.argv[4]}))" "$BASE_SHA" "$MERGE_SHA" "$MERGE_PARENTS" "$VERDICT")" \
      >/dev/null \
      || die 4 "the merge commit exists but its landing state could not be recorded -- --continue would be impossible" "git -C $ROOT log -1"
  fi
fi

record_refusal_step() {
  local step=$1
  if [ "$DRY_RUN" = "0" ]; then
    py_landing state --root "$ROOT" --branch "$BRANCH" write \
      --json "$(python3 -c "import json,sys; print(json.dumps({'refusal_step': sys.argv[1]}))" "$step")" \
      >/dev/null 2>&1 || true
  fi
}

RESUME_STEP=${RESUME_STEP:-}

# ---------------------------------------------------------------------------
# Step 4 — the suites (skipped entirely under --dry-run; DRY2 parameterises
# only over PRE3/PRV2/CHK2/CHK5/SAN3/WLD1/WLD2, never the suites)

if [ "$DRY_RUN" = "0" ] && { [ "$RESUME_ONLY" = "0" ] || [ "$RESUME_STEP" = "suites" ]; }; then
  # MAJ-3, measured 2026-08-30 on this host, in the two runs the constraints
  # require -- a split reproducible from what is written here:
  #     pytest tests/test_js_dom.py                 106 tests, 312.3 s | 304.8 s
  #     pytest tests --ignore=tests/test_js_dom.py 1208 tests, 264.9 s | 303.3 s
  #                                               ------------------------------
  #                                               1314 tests,   577.2 s | 608.1 s
  # TWO runs, hours apart, on the same host: 577.2 s and 608.1 s. The gate
  # independently measured 568 s. So the honest figure is a RANGE, 568-608 s,
  # and the budget is set against the WORST observed rather than any single
  # run -- which is the whole lesson of the 600 s cliff this replaced.
  # The UI suite runs SERIALLY -- there is no xdist in the UI venv. Against
  # the old 600 s budget that is a cliff, not a margin: a machine 1 %
  # slower turns a green suite into a `SUI2` timeout refusal. The CLI
  # suite is ~87 s under `-n auto`, so the budget is set by the UI one.
  #
  # 1800 s is ~2.96x the WORST observed run (608.1 s) and ~3.2x the median,
  # matching the headroom the original 600 s was chosen to give over the
  # then-measured 243/230 s. The real
  # fix is xdist in the UI venv, which is its own unit with its own gate
  # and is recommended in the handoff, NOT absorbed here.
  SUITE_TIMEOUT=${SUITE_TIMEOUT:-1800}

  # docs-only lane detector (SUI6): an ALLOWLIST, `--no-renames` (gate M-12)
  # SUI6's detector needs a floor of its own. `grep -cv` over an empty diff
  # yields 0, which selects the NARROWER docs lane -- so a bogus range, or a
  # diff that failed, silently runs FEWER tests. That is the worst direction
  # for this one to fail, so the total is measured first and a zero-path
  # range refuses rather than choosing a lane.
  CHANGED=$(git -C "$GITROOT" diff --no-renames --name-only "$BASE_SHA..HEAD") \
    || die 5 "SUI6: could not enumerate the changed paths for $BASE_SHA..HEAD"
  CHANGED_N=$(printf '%s\n' "$CHANGED" | grep -c . || true)
  [ "$CHANGED_N" -ge 1 ] \
    || die 5 "SUI6: the range $BASE_SHA..HEAD changed ZERO paths -- refusing to pick a lane from a diff that saw nothing" \
            "git -C $GITROOT diff --stat $BASE_SHA..HEAD"
  NONDOC=$(printf '%s\n' "$CHANGED" | grep -cv '^docs/' || true)
  echo "land: lane detector -- $CHANGED_N changed path(s), $NONDOC outside docs/"
  if [ "$NONDOC" = "0" ]; then
    LANE=docs
  else
    LANE=full
  fi

  # `run_suite` records the cwd it used ALONGSIDE the log. That pairing is
  # B-1's fix: the adjudicator re-expresses every node id from THIS
  # directory into the repo-root frame the allowlist is written in, so the
  # allowlist can no longer drift from the invocation.
  run_suite() {
    local name=$1 dir=$2; shift 2
    need_dir "$dir" "suite '$name' working directory" 5
    printf '%s\n' "$dir" >"$OUT/$name.cwd"
    # MIN-3: a killed suite can leave artefacts behind in the tree being
    # landed, and nothing observed that. The porcelain is snapshotted
    # either side of every run and the DELTA recorded, so "the suite left
    # the tree as it found it" is a measurement rather than an assumption.
    git -C "$GITROOT" status --porcelain >"$OUT/$name.porcelain.before" 2>/dev/null || true
    ( cd "$dir" && timeout "$SUITE_TIMEOUT" "$@" ) >"$OUT/$name.log" 2>&1
    local rc=$?
    printf '%s\n' "$rc" >"$OUT/$name.rc"
    git -C "$GITROOT" status --porcelain >"$OUT/$name.porcelain.after" 2>/dev/null || true
    diff "$OUT/$name.porcelain.before" "$OUT/$name.porcelain.after" \
      >"$OUT/$name.litter" 2>&1 || true
    local litter
    litter=$(grep -c '^>' "$OUT/$name.litter" || true)
    printf '%s\n' "$litter" >"$OUT/$name.litter.count"
    # NIT-2: the porcelain delta counts CHANGED paths -- new, modified or
    # deleted -- not only untracked ones. Same class as the STALE
    # records-versus-lines noun.
    [ "$litter" = "0" ] || echo "land: warning -- the $name suite left $litter changed path(s) in the tree (see $OUT/$name.litter)"
    return 0
  }

  ALLOWLIST="$GITROOT/plugins/self-learn/cli/src/self_learn/landing/known_failures.txt"
  need_file "$ALLOWLIST" "SUI3 known-failure allowlist" 5

  # SUI3/SUI9. The verdict comes from self_learn.landing.suites, which owns
  # the frame arithmetic and refuses on an unparseable log rather than
  # reading it as clean. Its stdout is the adjudication record.
  allowlisted_only() {
    local n=$1
    local cwd
    cwd=$(cat "$OUT/$n.cwd")
    py_landing suites --root "$GITROOT" adjudicate \
      --cwd "$cwd" --log "$OUT/$n.log" --allow "$ALLOWLIST" \
      >"$OUT/$n.adjudication" 2>&1
    return $?
  }

  adjudicate_suite() {
    local n=$1
    local rc
    rc=$(cat "$OUT/$n.rc" 2>/dev/null || echo 99)
    case "$rc" in
      0) ;;
      124) record_refusal_step suites
           die 5 "$n suite TIMED OUT after ${SUITE_TIMEOUT}s, leaving $(cat "$OUT/$n.litter.count" 2>/dev/null || echo '?') changed path(s) in the tree -- a killed suite does not clean up after itself. See $OUT/$n.log and $OUT/$n.litter" "less $OUT/$n.log" ;;
      2) record_refusal_step suites; die 5 "$n suite COLLECTION ERROR (rc 2) -- NOT a test failure; the allowlist cannot adjudicate it. See $OUT/$n.log" "less $OUT/$n.log" ;;
      5) record_refusal_step suites; die 5 "$n suite collected NO TESTS (rc 5) -- the suite ran but had nothing to adjudicate; an empty run must never read as green (SUI9). See $OUT/$n.log" "less $OUT/$n.log" ;;
      *)
        if ! allowlisted_only "$n"; then
          record_refusal_step suites
          local why
          why=$(cat "$OUT/$n.adjudication" 2>/dev/null || echo "unknown")
          case "$why" in
            unparseable-log*)
              die 5 "$n suite exited rc=$rc but its log yields NO FAILED/ERROR node id -- the known-failure allowlist cannot see its target, so this is a REFUSAL, never a pass (SUI9). See $OUT/$n.log" "less $OUT/$n.log" ;;
            unreadable-allowlist*)
              die 5 "$n suite red (rc=$rc) and the known-failure allowlist is unreadable: $why" "less $OUT/$n.log" ;;
            *)
              die 5 "$n suite red -- $why -- see $OUT/$n.log" "less $OUT/$n.log" ;;
          esac
        fi ;;
    esac
  }

  # MINOR-4, FIXED rather than documented. The suite step is the longest
  # phase (~11 min) and the one an operator is most likely to interrupt,
  # and until now an interrupt left NO resumable state -- the step was
  # recorded only on a refusal. Recording it here means a Ctrl-C leaves a
  # landing `--continue` picks up at the suites; it is advanced to
  # `sanitize` once they pass, so a later resume does not redo them.
  record_refusal_step suites

  if [ "$LANE" = "docs" ]; then
    DOC_SET_FILE="$GITROOT/plugins/self-learn/cli/src/self_learn/landing/doc_reading_set.txt"
    # B-2: this file vanishing used to produce an empty DOC_ARGS, a bare
    # root `pytest`, rc 0, and a PUSH. Measured twice by the r1 gate.
    need_nonempty_file "$DOC_SET_FILE" "SUI7 docs-lane test set" 5
    DOC_SET_N=$(usable_lines "$DOC_SET_FILE")
    DOC_ARGS=()
    while IFS= read -r line; do
      case "$line" in ""|\#*) continue ;; esac
      need_file "$GITROOT/$line" "SUI7 docs-lane entry" 5
      DOC_ARGS+=("$GITROOT/$line")
    done < "$DOC_SET_FILE"
    # positive control: the count the file promised is the count we built.
    [ "${#DOC_ARGS[@]}" = "$DOC_SET_N" ] \
      || die 5 "SUI7 docs-lane set: read $DOC_SET_N usable lines but built ${#DOC_ARGS[@]} arguments" "cat $DOC_SET_FILE"
    echo "land: docs lane over ${#DOC_ARGS[@]} module(s)"
    run_suite docslane "$GITROOT" \
      env -u SELF_LEARN_ANALYST_MODEL -u SELF_LEARN_ANALYST_TIMEOUT \
      uv run --project "$PROJECT" --no-sync pytest -p no:cacheprovider -q "${DOC_ARGS[@]}"
    adjudicate_suite docslane
  else
    CLI_SUITE="$GITROOT/plugins/self-learn/cli/scripts/suite"
    need_file "$CLI_SUITE" "SUI1 CLI suite runner" 5
    [ -x "$CLI_SUITE" ] || die 5 "SUI1 CLI suite runner is not executable: $CLI_SUITE" "ls -l $CLI_SUITE"
    run_suite cli "$GITROOT" "$CLI_SUITE"
    run_suite ui "$GITROOT/plugins/self-learn/ui" \
      env -u SELF_LEARN_ANALYST_MODEL -u SELF_LEARN_ANALYST_TIMEOUT \
      uv run --project . pytest -q
    adjudicate_suite cli
    adjudicate_suite ui
  fi
  record_refusal_step sanitize
fi

# ---------------------------------------------------------------------------
# Step 5 — sanitize (§4.7): ADDED lines of origin/master..HEAD only

if [ "$DRY_RUN" = "1" ] || [ "$RESUME_ONLY" = "0" ] || [ "$RESUME_STEP" = "suites" ] || [ "$RESUME_STEP" = "sanitize" ]; then
  SAN_ARGS=()
  for a in "${SANITIZE_ACK_ARGS[@]+"${SANITIZE_ACK_ARGS[@]}"}"; do
    SAN_ARGS+=(--sanitize-ack "$a")
  done
  if ! py_landing sanitize --root "$GITROOT" --range "$BASE_SHA..HEAD" --check "${SAN_ARGS[@]}" >"$OUT/sanitize.log" 2>&1; then
    record_refusal_step sanitize
    # N-18: print paste-ready --sanitize-ack strings on refusal, not just
    # point at the log file.
    cat "$OUT/sanitize.log" >&2
    die 6 "sanitize gate refused -- see $OUT/sanitize.log" "cat $OUT/sanitize.log"
  fi
fi

if [ "$DRY_RUN" = "1" ]; then
  echo "would-be merge commit: $(git -C "$GITROOT" rev-parse HEAD)"
  echo "DRY RUN — nothing pushed"
  exit 0
fi

# ---------------------------------------------------------------------------
# Step 6 — push and prune

if [ "$RESUME_ONLY" = "0" ] || [ "$RESUME_STEP" = "suites" ] || [ "$RESUME_STEP" = "sanitize" ] || [ "$RESUME_STEP" = "push" ]; then
  OLD_ORIGIN=$(git -C "$ROOT" rev-parse origin/master 2>/dev/null || echo "")
  git -C "$ROOT" push origin master >"$OUT/push.log" 2>&1
  PUSH_RC=$?
  if [ "$PUSH_RC" != "0" ]; then
    record_refusal_step push
    die 7 "push failed (rc=$PUSH_RC) -- see $OUT/push.log" "cat $OUT/push.log"
  fi
  NEW_ORIGIN=$(git -C "$ROOT" rev-parse origin/master)
  printf 'pushed: %s..%s\n' "$OLD_ORIGIN" "$NEW_ORIGIN"

  py_landing state --root "$ROOT" --branch "$BRANCH" clear >/dev/null 2>&1 || true

  # prune -- best-effort, never fails the landing (N-8)
  WT=""
  cur=""
  while IFS= read -r line; do
    case "$line" in
      worktree\ *) cur=${line#worktree } ;;
      "branch refs/heads/$BRANCH") WT=$cur ;;
    esac
  done < <(git -C "$ROOT" worktree list --porcelain)
  if [ -n "$WT" ]; then
    if ! git -C "$ROOT" worktree remove "$WT" >"$OUT/prune.log" 2>&1; then
      echo "land: warning -- could not prune worktree $WT (see $OUT/prune.log); clean it up by hand"
    fi
  fi
  if ! git -C "$ROOT" branch -d "$BRANCH" >>"$OUT/prune.log" 2>&1; then
    echo "land: warning -- could not delete branch $BRANCH (see $OUT/prune.log); clean it up by hand"
  fi
fi

echo "land: done. logs=$OUT"
exit 0
