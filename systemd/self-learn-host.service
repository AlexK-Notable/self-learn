# self-learn host process (U-engine Phase 2, spec Sec 5) -- the
# long-lived scheduler: it starts `miner.run`/`worker.run` as jobs
# (SERIALLY, spec Sec 5.2a), replacing self-learn-miner.timer's nightly
# fire, the miner-to-worker handoff's setsid Popen (register item #11,
# closed by construction -- there is no detached child for a cgroup to
# reap), and the covert any-verb watchdog (reduced, not retired: spec
# Sec 5.3 -- a verb pokes this daemon instead of spawning its own run
# once a fresh heartbeat proves it is alive).
#
# Conventions mirror self-learn-ui.service (comment header, %h-relative
# paths, explicit env pin, Restart=on-failure/RestartSec=5).
#
# Installed by install.sh (which links this unit into
# ~/.config/systemd/user/ -- or $XDG_CONFIG_HOME/systemd/user/ if set,
# U-servehermetic 2026-08-27 -- and runs `systemctl --user daemon-reload`);
# enabling it is the one step it deliberately leaves to you:
#   systemctl --user enable --now self-learn-host.service
#
# Once enabled, self-learn-miner.timer should NOT also stay enabled --
# `self-learn doctor invocation` warns (never fails) if both are, since
# the pairing is merely double work, not corruption (miner.spawn.lock
# and worker.lock still serialise them either way). A timer left enabled
# on purpose is supported as a belt-and-braces poke (spec Sec 5.7).
#
# systemd absent / non-Linux host (spec Sec 5.7): the documented
# fallback is running `self-learn serve` in the foreground -- this unit
# is a convenience, not a hard dependency. `serve` ports unchanged to
# launchd or a bare terminal window.
[Unit]
Description=self-learn host process (scheduler + heartbeat)
# B-9: this unit carried no start limit at all -- the "no StartLimitBurst"
# gap named in the PATH comment below is exactly this. With
# Restart=on-failure and no burst cap, a boot-order or environment fault
# that keeps failing restarts forever, silently, with no eventual "give
# up" signal. A 5-minute window with a burst of 5 mirrors RestartSec=5
# below (five back-to-back restarts fill the window); systemd stops
# trying and marks the unit failed once the burst is exceeded, rather
# than looping quietly forever.
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=simple
# B-8: a `systemctl --user stop` used to log as a FAILED exit, because
# systemd's default success set is {0} only and SIGTERM is not in it.
# Declaring 143 (128+SIGTERM, the POSIX shell convention) AND the bare
# signal name SIGTERM as additional success statuses makes an
# intentional stop read as clean, matching what actually happened.
# NOTE `run_forever` (serve.py) installs its own SIGTERM handler and
# already returns a genuine exit 0 once it sees the signal -- so this
# key's job is the window before that handler is installed (wrapper/uv
# startup, still running under the default disposition) and any other
# path where the process is torn down BY the signal rather than exiting
# through its own handler. It is not a "self-signal" mechanism -- this
# unit has none (contrast self-learn-ui.service's SuccessExitStatus
# comment, corrected of exactly that false claim for its idle self-exit
# path, which uses no signal at all).
SuccessExitStatus=143 SIGTERM
# B-1 (doc 13 Sec 7.1), carried from self-learn-miner.service/self-learn-ui.service:
# the systemd user manager does not inherit the shell's env -- pin the
# ledger home explicitly so the unit and the shell agree.
Environment=SELF_LEARN_HOME=%h/.self-learn
# U-uvpath (2026-08-29), same B-1 reasoning applied to PATH: this unit
# crash-looped six times on 2026-08-28 22:17-22:18 with "exec: uv: not
# found" (exit 127/n/a) -- ExecStart's wrapper resolves `uv` off PATH,
# and the systemd user manager's PATH does not reliably include
# %h/.local/bin (uv's pipx install dir on this host). The prior
# "it works" was a boot-order race against the desktop session's
# imported PATH, not a fix -- with Restart=on-failure and no
# StartLimitBurst, a boot that loses the race gives an infinite silent
# restart loop with no working daemon. Pin a floor with %h/.local/bin
# ahead of the standard system dirs; the wrapper itself also falls back
# to well-known absolute uv locations independently (belt and braces --
# this fixes the unit even if the wrapper is ever bypassed).
# Gate r1 fold (2026-08-29): %h/bin is in this floor too -- worker.py's
# self-learn-notify dispatch resolves that helper with shutil.which()
# (the ~/bin deploy surface, install.sh links it there), degrading to a
# direct notify-send only when the helper can't be found. This unit's
# PATH used to have none at all, so %h/bin arrived by the same
# boot-order accident as everything else pinned here; a hard PATH
# replacement that dropped it would quietly regress a path that
# previously worked.
Environment=PATH=%h/bin:%h/.local/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=%h/bin/self-learn serve
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target
