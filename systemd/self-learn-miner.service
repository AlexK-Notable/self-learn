# self-learn transcript miner (doc 12) — one mining pass.
# Installed by install.sh (which links this unit + its timer into
# ~/.config/systemd/user/ -- or $XDG_CONFIG_HOME/systemd/user/ if set,
# U-servehermetic 2026-08-27 -- and runs `systemctl --user daemon-reload`);
# enabling the timer is the one step it deliberately leaves to you:
#   systemctl --user enable --now self-learn-miner.timer
[Unit]
Description=self-learn transcript miner (nightly pass)

[Service]
Type=oneshot
# B-1 (doc 13 §7.1): the systemd user manager does not inherit the shell's
# env — pin the ledger home explicitly so the unit and the shell agree.
Environment=SELF_LEARN_HOME=%h/.self-learn
# U-uvpath (2026-08-29, gate r1 MINOR-3 — ruled in scope, the identical
# defect class as the host/ui units): this unit's ExecStart goes through
# the same scripts/self-learn wrapper, so it depends on `uv` being
# resolvable exactly like self-learn-host.service did when it
# crash-looped six times on 2026-08-28 (see that unit's own comment).
# No %h/bin here, unlike the host/ui units — measured: this unit only
# ever runs `mine run --trigger timer`, which re-spawns itself (if at
# all) via `sys.executable -m self_learn.cli` (miner.py's
# `_spawn_run`), an absolute interpreter path, never a bare-name PATH
# lookup, and it never calls the self-learn-notify helper the host/ui
# units' %h/bin exists for (that dispatch is worker-only, worker.py:3102
# — this unit never runs `worker.run`). The `claude` CLI itself needs no
# PATH pin either, on any of the three units: `claude_agent_sdk`'s own
# `_find_cli()` (used by ALL FOUR surfaces, miner included, since
# U-cleanup-B) checks a binary BUNDLED inside the installed package
# first — confirmed present in this project's own .venv
# (claude_agent_sdk/_bundled/claude) — before ever touching PATH, and
# even lacking that bundle it already tries `shutil.which("claude")`
# then a hardcoded ~/.local/bin/claude-shaped fallback list on its own,
# the same PATH-then-fallback shape this unit's own wrapper now
# implements for uv. No wrapper-style treatment is owed to `claude`
# anywhere in this codebase; sized as zero additional work, not scoped
# out as a bigger unit.
Environment=PATH=%h/.local/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=%h/bin/self-learn mine run --trigger timer
# The run spawns a contained `claude -p` reader; give it headroom.
TimeoutStartSec=30m
Nice=10
