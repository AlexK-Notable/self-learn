# self-learn adjudication UI (doc 09/10 surface) — the localhost web
# server. Resident WHILE IN USE (09 §3, Y-14 2026-07-18): "the server
# IS the single instance" — multiple browser tabs/windows are
# concurrent readers of the one running process — but the process
# self-exits cleanly (exit 0) after ~10 idle minutes with no pages
# open, no verb running, and no agent session mid-turn. Under
# Restart=on-failure below, a clean exit stays down; the launcher
# (self-learn-ui-open — notification click / .desktop entry) starts it
# again on demand, so `enable --now` is optional: a boot-time start
# just idles out after one window, harmlessly. Crash-restart behavior
# is unchanged. Conventions mirror self-learn-miner.service (comment
# header, %h-relative paths, explicit env pin).
#
# Installed by install.sh (which links this unit into
# ~/.config/systemd/user/ -- or $XDG_CONFIG_HOME/systemd/user/ if set,
# U-servehermetic 2026-08-27 -- and runs `systemctl --user daemon-reload`);
# enabling it is the one step it deliberately leaves to you:
#   systemctl --user enable --now self-learn-ui.service
#
# systemd absent / non-Linux host (10 §5): the documented fallback is
# running `self-learn-ui serve` in the foreground — this unit is a
# convenience, not a hard dependency.
[Unit]
Description=self-learn adjudication UI (localhost web server)

[Service]
Type=simple
# B-1 (doc 13 §7.1), carried from self-learn-miner.service: the systemd
# user manager does not inherit the shell's env — pin the ledger home
# explicitly so the unit and the shell agree.
Environment=SELF_LEARN_HOME=%h/.self-learn
# U-uvpath (2026-08-29), same B-1 reasoning applied to PATH: the sibling
# self-learn-host.service crash-looped six times on 2026-08-28
# 22:17-22:18 with "exec: uv: not found" (exit 127/n/a) — ExecStart's
# wrapper resolves `uv` off PATH, and the systemd user manager's PATH
# does not reliably include %h/.local/bin (uv's pipx install dir on
# this host). This unit shares the same ExecStart shape and was never
# observed to fail only because the desktop session's imported PATH won
# the boot-order race — not a guarantee. Pin a floor with
# %h/.local/bin ahead of the standard system dirs; the wrapper itself
# also falls back to well-known absolute uv locations independently
# (belt and braces — this fixes the unit even if the wrapper is ever
# bypassed).
# Gate r1 fold (2026-08-29): %h/bin is in this floor too, for the same
# reason the host unit carries it — worker.py's self-learn-notify
# dispatch resolves that helper via shutil.which() (the ~/bin deploy
# surface), and this unit's prior no-PATH-at-all state let %h/bin
# through by the same accident as everything else.
Environment=PATH=%h/bin:%h/.local/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=%h/bin/self-learn-ui serve
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target
